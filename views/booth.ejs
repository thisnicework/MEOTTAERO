<%- include('partials/header') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/tracking.js/1.1.3/tracking-min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/tracking.js/1.1.3/data/face-min.js"></script>

<style>
  /* Indifferent, raw typography styles for filter options */
  .filter-opt-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--color-fg);
    padding: 0;
    transition: color 0.15s ease;
    text-transform: lowercase;
  }
  .filter-opt-btn:hover {
    color: var(--color-high);
  }
  .filter-opt-btn.active {
    color: var(--color-high) !important;
    text-decoration: underline;
  }
  
  /* Circular Shutter Button in MEOTTAERO Blue */
  .shutter-btn {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 3px solid var(--color-fg);
    background-color: var(--color-high);
    cursor: pointer;
    outline: none;
    transition: transform 0.1s ease, background-color 0.2s ease, border-color 0.2s ease;
    box-shadow: 0 0 0 2px var(--color-bg), 0 0 0 3px var(--color-fg);
    padding: 0;
  }
  .shutter-btn:hover {
    transform: scale(1.06);
  }
  .shutter-btn:active {
    transform: scale(0.94);
    background-color: #0000cc;
  }
  .shutter-btn:disabled {
    background-color: #9999ff;
    border-color: #777;
    cursor: not-allowed;
    transform: none;
  }
</style>

<main style="display: flex; flex-direction: column; align-items: center; min-height: calc(100vh - 6rem); box-sizing: border-box;">
  <!-- Spacer above (takes 40% of vertical space) -->
  <div style="flex: 4;"></div>

  <div class="column" style="max-width: 500px; width: 100%; margin: 0 auto; padding: 0 1rem; flex-shrink: 0;">
    
    <!-- Webcam Video / Canvas Wrap -->
    <div class="video-wrap" style="position: relative; width: 100%; aspect-ratio: 4/3; background: #000; border: 1px solid var(--color-fg); margin-bottom: 1.5rem; overflow: hidden; display: flex; align-items: center; justify-content: center;">
      <!-- Hidden Video Element with explicit dimensions for tracking.js -->
      <video id="webcam" autoplay playsinline muted width="640" height="480" style="position: absolute; opacity: 0; pointer-events: none; width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1);"></video>
      <!-- Visible Canvas Preview (displays everything unified) -->
      <canvas id="canvas-preview" style="width: 100%; height: 100%; object-fit: cover;"></canvas>
      
      <!-- Countdown overlay -->
      <div id="countdown" style="display: none; position: absolute; font-size: 8rem; font-weight: 900; color: white; text-shadow: 0 0 25px rgba(0,0,0,0.85); z-index: 10; pointer-events: none; font-family: monospace;">3</div>
      
      <!-- Flash overlay -->
      <div id="flash" style="display: none; position: absolute; top:0; left:0; width:100%; height:100%; background: white; z-index: 11; pointer-events: none;"></div>
      
      <!-- Permission warning -->
      <div id="permission-warning" style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #111; z-index: 5; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem; text-align: center; color: white;">
        <button id="retry-permission-btn" style="padding: 0.6rem 1.2rem; border: 1px solid white; background: transparent; color: white; cursor: pointer; font-family: inherit; font-size: 0.9rem;">카메라 허용</button>
      </div>
    </div>
    
    <!-- Capture Controls (Circular Shutter Button) -->
    <div style="margin-bottom: 2rem; display: flex; justify-content: center; align-items: center;">
      <button id="capture-btn" class="shutter-btn" aria-label="Take Photo"></button>
    </div>

    <!-- Filters Selection (Indifferent Text Links) -->
    <div style="display: flex; gap: 0.75rem; align-items: center; justify-content: center; font-size: 0.95rem; user-select: none;">
      <button class="filter-opt-btn active" data-filter="kinetic">kinetic</button>
      <span style="color: var(--color-mid); font-size: 0.85rem; opacity: 0.5;">/</span>
      <button class="filter-opt-btn" data-filter="slitscan">slitscan</button>
      <span style="color: var(--color-mid); font-size: 0.85rem; opacity: 0.5;">/</span>
      <button class="filter-opt-btn" data-filter="tunnel">tunnel <span style="font-size: 0.6rem; opacity: 0.55; vertical-align: super;">beta</span></button>
      <span style="color: var(--color-mid); font-size: 0.85rem; opacity: 0.5;">/</span>
      <button class="filter-opt-btn" data-filter="cyber">cyber glasses</button>
      <span style="color: var(--color-mid); font-size: 0.85rem; opacity: 0.5;">/</span>
      <button class="filter-opt-btn" data-filter="kitty">kitty mask</button>
      <span style="color: var(--color-mid); font-size: 0.85rem; opacity: 0.5;">/</span>
      <button class="filter-opt-btn" data-filter="popart">pop art</button>
      <span style="color: var(--color-mid); font-size: 0.85rem; opacity: 0.5;">/</span>
      <button class="filter-opt-btn" data-filter="mirror">mirror</button>
      <span style="color: var(--color-mid); font-size: 0.85rem; opacity: 0.5;">/</span>
      <button class="filter-opt-btn" data-filter="xray">x-ray</button>
    </div>

  </div>

  <!-- Spacer below (takes 60% of vertical space) -->
  <div style="flex: 6;"></div>
</main>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const video = document.getElementById('webcam');
    const canvasPreview = document.getElementById('canvas-preview');
    const captureBtn = document.getElementById('capture-btn');
    const filterBtns = document.querySelectorAll('.filter-opt-btn');
    const countdownOverlay = document.getElementById('countdown');
    const flashOverlay = document.getElementById('flash');
    const warningOverlay = document.getElementById('permission-warning');
    const retryBtn = document.getElementById('retry-permission-btn');

    let stream = null;
    let currentFilter = 'kinetic';
    
    // Kinetic filter variables
    let loopId = null;
    let lerpBuffer = null;
    const pixelSize = 3;
    const lerpWeight = 0.03;

    // Slitscan filter variables
    let scanY = 0;
    let slitscanReset = true;

    // Face Tracking Target Coordinates (Calculated via tracking.js)
    let targetFaceX = 320;
    let targetFaceY = 240;
    let targetFaceSize = 150; // Default baseline face width in 640x480
    
    // Smoothly interpolated coordinate values for the visual effect
    let mouseX = 320;
    let mouseY = 240;
    let faceSize = 150;

    // Initialize webcam
    let trackerInitialized = false;

    async function initCamera() {
      try {
        warningOverlay.style.display = 'none';
        if (stream) {
          stream.getTracks().forEach(track => track.stop());
        }

        stream = await navigator.mediaDevices.getUserMedia({
          video: { width: 640, height: 480, facingMode: 'user' },
          audio: false
        });
        video.srcObject = stream;
        
        // Wait until video is active and playing before initiating computer vision tracking
        video.onplaying = () => {
          if (!trackerInitialized) {
            initFaceTracker();
            trackerInitialized = true;
          }
          startRenderLoop();
        };
      } catch (err) {
        console.error('Camera access error:', err);
        warningOverlay.style.display = 'flex';
      }
    }

    // Initialize tracking.js (optimized for higher accuracy and sensitivity)
    function initFaceTracker() {
      try {
        const tracker = new tracking.ObjectTracker('face');
        tracker.setInitialScale(2.5); // Finer search scale to detect distant or smaller faces
        tracker.setStepSize(1.6);     // Finer step size for higher precision detection
        tracker.setEdgesDensity(0.1);

        tracker.on('track', function (event) {
          if (event.data.length > 0) {
            // Find largest face box
            let maxFace = event.data[0];
            for (let i = 1; i < event.data.length; i++) {
              if (event.data[i].width * event.data[i].height > maxFace.width * maxFace.height) {
                maxFace = event.data[i];
              }
            }
            
            // Calculate center of face in 640x480 space
            targetFaceX = maxFace.x + maxFace.width / 2;
            targetFaceY = maxFace.y + maxFace.height / 2;
            targetFaceSize = maxFace.width;
          }
        });

        tracking.track('#webcam', tracker);
      } catch (e) {
        console.warn('Face tracker init failed:', e);
      }
    }

    // Retry permission
    retryBtn.addEventListener('click', initCamera);

    // Apply Filter selection
    filterBtns.forEach(btn => {
      btn.addEventListener('click', function () {
        filterBtns.forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        currentFilter = this.getAttribute('data-filter');
        
        // Reset slitscan state when switching filters
        if (currentFilter !== 'slitscan') {
          slitscanReset = true;
        }
      });
    });

    // Unified 60fps Canvas Render Loop
    function startRenderLoop() {
      if (loopId) return;
      
      const ctx = canvasPreview.getContext('2d');
      const offscreen = document.createElement('canvas');
      const offscreenCtx = offscreen.getContext('2d');

      function drawFrame() {
        if (!stream) {
          loopId = requestAnimationFrame(drawFrame);
          return;
        }

        const w = video.videoWidth || 640;
        const h = video.videoHeight || 480;

        if (canvasPreview.width !== w || canvasPreview.height !== h) {
          canvasPreview.width = w;
          canvasPreview.height = h;
        }

        // Smoothly interpolate current coordinates towards target face coordinates (10% Lerp)
        mouseX += (targetFaceX - mouseX) * 0.1;
        mouseY += (targetFaceY - mouseY) * 0.1;
        faceSize += (targetFaceSize - faceSize) * 0.1;

        ctx.save();
        
        // Clear background (except for slitscan which accumulates slices over time)
        if (currentFilter !== 'slitscan') {
          ctx.fillStyle = '#000';
          ctx.fillRect(0, 0, w, h);
        }
        ctx.filter = 'none';

        if (currentFilter === 'tunnel') {
          // Interactive Infinite Recursive Tunnel (Mirrored background + Offset nested recursion following face)
          ctx.translate(w, 0);
          ctx.scale(-1, 1);
          ctx.drawImage(video, 0, 0, w, h);
          
          // Map face size (depth) to recursive exponential scaling factor:
          // faceSize typically ranges from 80 (far) to 300 (close).
          const clampedSize = Math.max(80, Math.min(300, faceSize));
          // Exponential decay factor varies between 0.65 (steep/far) and 0.88 (slow/close)
          const factor = 0.65 + ((clampedSize - 80) / 220) * 0.23;
          
          // Draw exactly 6 recursive images
          for (let i = 1; i <= 6; i++) {
            const scale = Math.pow(factor, i);
            
            const nw = w * scale;
            const nh = h * scale;
            
            // Map face coordinates to mirrored coordinates space (with both X and Y axes inverted for opposite motion)
            const oppositeX = mouseX; // Directly using mouseX in mirrored space draws it on the opposite side
            const oppositeY = h - mouseY; // Inverts Y axis
            
            const bias = i / 6;
            const targetCenterX = w / 2 + (oppositeX - w / 2) * bias;
            const targetCenterY = h / 2 + (oppositeY - h / 2) * bias;
            
            const nx = targetCenterX - nw / 2;
            const ny = targetCenterY - nh / 2;
            ctx.drawImage(video, nx, ny, nw, nh);
          }
        }
        else if (currentFilter === 'slitscan') {
          if (slitscanReset) {
            ctx.fillStyle = '#000';
            ctx.fillRect(0, 0, w, h);
            scanY = 0;
            slitscanReset = false;
          }

          // Render mirrored frame to offscreen canvas (only resize if dimensions changed)
          if (offscreen.width !== w || offscreen.height !== h) {
            offscreen.width = w;
            offscreen.height = h;
          }
          offscreenCtx.save();
          offscreenCtx.translate(w, 0);
          offscreenCtx.scale(-1, 1);
          offscreenCtx.drawImage(video, 0, 0, w, h);
          offscreenCtx.restore();

          const scanSpeed = 2; // Incremented resolution for cleaner details

          // Draw the thin horizontal slice from the mirrored offscreen frame (completely overwrites the previous indicator)
          ctx.drawImage(offscreen, 0, scanY, w, scanSpeed, 0, scanY, w, scanSpeed);

          // Advance scan position
          scanY += scanSpeed;
          if (scanY >= h) {
            scanY = 0;
          }

          // Draw the blue scanline indicator at the NEXT scan position so it gets cleanly overwritten in the next frame
          ctx.fillStyle = 'var(--color-high)';
          ctx.fillRect(0, scanY, w, scanSpeed);
        }
        else if (currentFilter === 'kinetic') {
          // Dreamy Pixelated Lerp Trail
          const cols = Math.floor(w / pixelSize);
          const rows = Math.floor(h / pixelSize);

          if (offscreen.width !== cols || offscreen.height !== rows) {
            offscreen.width = cols;
            offscreen.height = rows;
            lerpBuffer = new Float32Array(cols * rows * 3);
          }

          offscreenCtx.drawImage(video, 0, 0, cols, rows);
          const imgData = offscreenCtx.getImageData(0, 0, cols, rows).data;

          ctx.fillStyle = '#dcdcdc'; // equivalent to background(220)
          ctx.fillRect(0, 0, w, h);

          for (let y = 0; y < rows; y++) {
            for (let x = 0; x < cols; x++) {
              const pixelIdx = (y * cols + x);
              const imgDataIdx = pixelIdx * 4;
              const bufIdx = pixelIdx * 3;

              const targetR = imgData[imgDataIdx];
              const targetG = imgData[imgDataIdx + 1];
              const targetB = imgData[imgDataIdx + 2];

              lerpBuffer[bufIdx] += (targetR - lerpBuffer[bufIdx]) * lerpWeight;
              lerpBuffer[bufIdx + 1] += (targetG - lerpBuffer[bufIdx + 1]) * lerpWeight;
              lerpBuffer[bufIdx + 2] += (targetB - lerpBuffer[bufIdx + 2]) * lerpWeight;

              ctx.fillStyle = `rgb(${Math.round(lerpBuffer[bufIdx])}, ${Math.round(lerpBuffer[bufIdx + 1])}, ${Math.round(lerpBuffer[bufIdx + 2])})`;
              const mirroredX = cols - 1 - x;
              ctx.fillRect(mirroredX * pixelSize, y * pixelSize, pixelSize, pixelSize);
            }
          }
        }
        else if (currentFilter === 'cyber') {
          // 원래 비디오 그리기 (거울 모드로 그리기)
          ctx.save();
          ctx.translate(w, 0);
          ctx.scale(-1, 1);
          ctx.drawImage(video, 0, 0, w, h);
          ctx.restore();

          // 얼굴이 인식된 상태인지 확인
          if (faceSize > 10) {
            ctx.save();
            ctx.translate(w, 0);
            ctx.scale(-1, 1);

            // 선글라스 그리기
            const eyeY = mouseY - faceSize * 0.05;
            const eyeX = mouseX;

            // 사이버 안경 프레임
            ctx.shadowBlur = 15;
            ctx.shadowColor = '#00ffcc';
            ctx.strokeStyle = '#00ffcc';
            ctx.lineWidth = Math.max(3, faceSize * 0.04);
            ctx.fillStyle = 'rgba(10, 10, 10, 0.85)';

            const lensRadius = faceSize * 0.18;
            const dist = faceSize * 0.18; // 눈 간격

            // 왼쪽 렌즈
            ctx.beginPath();
            ctx.arc(eyeX - dist, eyeY, lensRadius, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();

            // 오른쪽 렌즈
            ctx.beginPath();
            ctx.arc(eyeX + dist, eyeY, lensRadius, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();

            // 안경 다리/브릿지 연결선
            ctx.beginPath();
            ctx.moveTo(eyeX - dist + lensRadius, eyeY);
            ctx.lineTo(eyeX + dist - lensRadius, eyeY);
            ctx.stroke();

            // 광원 반사선
            ctx.shadowBlur = 0;
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.6)';
            ctx.lineWidth = Math.max(2, faceSize * 0.02);
            ctx.beginPath();
            ctx.moveTo(eyeX - dist - lensRadius * 0.5, eyeY - lensRadius * 0.5);
            ctx.lineTo(eyeX - dist + lensRadius * 0.2, eyeY + lensRadius * 0.2);
            ctx.moveTo(eyeX + dist - lensRadius * 0.5, eyeY - lensRadius * 0.5);
            ctx.lineTo(eyeX + dist + lensRadius * 0.2, eyeY + lensRadius * 0.2);
            ctx.stroke();

            ctx.restore();
          }
        }
        else if (currentFilter === 'kitty') {
          // 비디오 그리기
          ctx.save();
          ctx.translate(w, 0);
          ctx.scale(-1, 1);
          ctx.drawImage(video, 0, 0, w, h);
          ctx.restore();

          if (faceSize > 10) {
            ctx.save();
            ctx.translate(w, 0);
            ctx.scale(-1, 1);

            const noseX = mouseX;
            const noseY = mouseY + faceSize * 0.08; 
            const earSize = faceSize * 0.25;
            const earDistY = faceSize * 0.4; 
            const earDistX = faceSize * 0.35; 

            // 1. 고양이 귀 그리기
            ctx.fillStyle = '#ff6b81'; // 기본 귀 색상 (분홍 계열)
            ctx.strokeStyle = '#000000';
            ctx.lineWidth = Math.max(3, faceSize * 0.03);

            // 왼쪽 귀
            ctx.beginPath();
            ctx.moveTo(mouseX - earDistX, mouseY - earDistY);
            ctx.lineTo(mouseX - earDistX - earSize * 0.4, mouseY - earDistY - earSize);
            ctx.lineTo(mouseX - earDistX + earSize * 0.6, mouseY - earDistY + earSize * 0.1);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
            
            // 왼쪽 귀 안쪽
            ctx.fillStyle = '#ffb8b8';
            ctx.beginPath();
            ctx.moveTo(mouseX - earDistX - earSize * 0.05, mouseY - earDistY - earSize * 0.1);
            ctx.lineTo(mouseX - earDistX - earSize * 0.25, mouseY - earDistY - earSize * 0.7);
            ctx.lineTo(mouseX - earDistX + earSize * 0.35, mouseY - earDistY - earSize * 0.05);
            ctx.closePath();
            ctx.fill();

            // 오른쪽 귀
            ctx.fillStyle = '#ff6b81';
            ctx.beginPath();
            ctx.moveTo(mouseX + earDistX, mouseY - earDistY);
            ctx.lineTo(mouseX + earDistX + earSize * 0.4, mouseY - earDistY - earSize);
            ctx.lineTo(mouseX + earDistX - earSize * 0.6, mouseY - earDistY + earSize * 0.1);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();

            // 오른쪽 귀 안쪽
            ctx.fillStyle = '#ffb8b8';
            ctx.beginPath();
            ctx.moveTo(mouseX + earDistX + earSize * 0.05, mouseY - earDistY - earSize * 0.1);
            ctx.lineTo(mouseX + earDistX + earSize * 0.25, mouseY - earDistY - earSize * 0.7);
            ctx.lineTo(mouseX + earDistX - earSize * 0.35, mouseY - earDistY - earSize * 0.05);
            ctx.closePath();
            ctx.fill();

            // 2. 고양이 코
            ctx.fillStyle = '#ff4757';
            ctx.beginPath();
            ctx.moveTo(noseX - faceSize * 0.04, noseY);
            ctx.lineTo(noseX + faceSize * 0.04, noseY);
            ctx.lineTo(noseX, noseY + faceSize * 0.04);
            ctx.closePath();
            ctx.fill();

            // 3. 고양이 수염
            ctx.strokeStyle = '#000000';
            ctx.lineWidth = Math.max(2, faceSize * 0.015);
            
            const whiskerLen = faceSize * 0.35;
            // 왼쪽 수염 3개
            ctx.beginPath();
            ctx.moveTo(noseX - faceSize * 0.06, noseY + faceSize * 0.02);
            ctx.lineTo(noseX - faceSize * 0.06 - whiskerLen, noseY - faceSize * 0.02);
            ctx.moveTo(noseX - faceSize * 0.06, noseY + faceSize * 0.02);
            ctx.lineTo(noseX - faceSize * 0.06 - whiskerLen, noseY + faceSize * 0.02);
            ctx.moveTo(noseX - faceSize * 0.06, noseY + faceSize * 0.02);
            ctx.lineTo(noseX - faceSize * 0.06 - whiskerLen, noseY + faceSize * 0.06);
            
            // 오른쪽 수염 3개
            ctx.moveTo(noseX + faceSize * 0.06, noseY + faceSize * 0.02);
            ctx.lineTo(noseX + faceSize * 0.06 + whiskerLen, noseY - faceSize * 0.02);
            ctx.moveTo(noseX + faceSize * 0.06, noseY + faceSize * 0.02);
            ctx.lineTo(noseX + faceSize * 0.06 + whiskerLen, noseY + faceSize * 0.02);
            ctx.moveTo(noseX + faceSize * 0.06, noseY + faceSize * 0.02);
            ctx.lineTo(noseX + faceSize * 0.06 + whiskerLen, noseY + faceSize * 0.06);
            ctx.stroke();

            ctx.restore();
          }
        }
        else if (currentFilter === 'popart') {
          // Pop Art 4-split Andy Warhol Style
          const halfW = w / 2;
          const halfH = h / 2;

          ctx.save();
          ctx.translate(w, 0);
          ctx.scale(-1, 1);

          // 1. Top-Left (Standard / High Contrast)
          ctx.save();
          ctx.filter = 'contrast(170%) saturate(180%)';
          ctx.drawImage(video, halfW, 0, halfW, halfH, 0, 0, halfW, halfH);
          ctx.restore();

          // 2. Top-Right (Cyan/Blue Tint)
          ctx.save();
          ctx.filter = 'contrast(150%) saturate(200%) hue-rotate(90deg)';
          ctx.drawImage(video, 0, 0, halfW, halfH, halfW, 0, halfW, halfH);
          ctx.restore();

          // 3. Bottom-Left (Magenta/Pink Tint)
          ctx.save();
          ctx.filter = 'contrast(150%) saturate(200%) hue-rotate(180deg)';
          ctx.drawImage(video, halfW, halfH, halfW, halfH, 0, halfH, halfW, halfH);
          ctx.restore();

          // 4. Bottom-Right (Greenish Tint)
          ctx.save();
          ctx.filter = 'contrast(150%) saturate(200%) hue-rotate(270deg)';
          ctx.drawImage(video, 0, halfH, halfW, halfH, halfW, halfH, halfW, halfH);
          ctx.restore();

          ctx.restore();
        }
        else if (currentFilter === 'mirror') {
          // Mirror half-reflection effect
          if (offscreen.width !== w || offscreen.height !== h) {
            offscreen.width = w;
            offscreen.height = h;
          }
          offscreenCtx.save();
          offscreenCtx.translate(w, 0);
          offscreenCtx.scale(-1, 1);
          offscreenCtx.drawImage(video, 0, 0, w, h);
          offscreenCtx.restore();

          ctx.save();
          // Draw left half normally
          ctx.drawImage(offscreen, 0, 0, w / 2, h, 0, 0, w / 2, h);
          // Mirror left half to the right half
          ctx.translate(w, 0);
          ctx.scale(-1, 1);
          ctx.drawImage(offscreen, 0, 0, w / 2, h, 0, 0, w / 2, h);
          ctx.restore();
        }
        else if (currentFilter === 'xray') {
          // X-Ray blue invert style
          ctx.save();
          ctx.translate(w, 0);
          ctx.scale(-1, 1);
          ctx.filter = 'grayscale(100%) invert(100%) hue-rotate(180deg) saturate(200%)';
          ctx.drawImage(video, 0, 0, w, h);
          ctx.restore();
        }
        else {
          // Normal fallback
          ctx.save();
          ctx.translate(w, 0);
          ctx.scale(-1, 1);
          ctx.drawImage(video, 0, 0, w, h);
          ctx.restore();
        }

        ctx.restore();
        loopId = requestAnimationFrame(drawFrame);
      }

      loopId = requestAnimationFrame(drawFrame);
    }

    // Silent Background Broadcast for Exhibition Venue Device (Low Frame Rate, Ultra HD Quality)
    let lastBroadcastTime = 0;
    setInterval(() => {
      if (!stream) return;
      const now = Date.now();
      if (now - lastBroadcastTime >= 3000) {
        lastBroadcastTime = now;
        try {
          let lowResData = '';
          const tempCanvas = document.createElement('canvas');
          tempCanvas.width = 1280;
          tempCanvas.height = 960;
          const tempCtx = tempCanvas.getContext('2d');

          if (video && video.videoWidth > 0) {
            tempCtx.translate(1280, 0);
            tempCtx.scale(-1, 1);
            tempCtx.drawImage(video, 0, 0, 1280, 960);
            lowResData = tempCanvas.toDataURL('image/jpeg', 0.90);
          } else if (canvasPreview && canvasPreview.width > 0 && canvasPreview.height > 0) {
            tempCtx.drawImage(canvasPreview, 0, 0, 1280, 960);
            lowResData = tempCanvas.toDataURL('image/jpeg', 0.90);
          }

          if (lowResData && lowResData.length > 200) {
            fetch('/api/stream/broadcast', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ image: lowResData })
            }).catch(() => {});
          }
        } catch (e) {}
      }
    }, 3000);

    // Web Audio dynamic camera shutter sound synthesizer
    function playShutterSound() {
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        const ctx = new AudioContext();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(800, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(150, ctx.currentTime + 0.15);

        gain.gain.setValueAtTime(0.2, ctx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, ctx.currentTime + 0.15);

        osc.start();
        osc.stop(ctx.currentTime + 0.15);
      } catch (e) {
        console.warn(e);
      }
    }

    // Capture functionality
    captureBtn.addEventListener('click', function () {
      if (!stream) return;

      captureBtn.disabled = true;
      let count = 3;
      countdownOverlay.textContent = count;
      countdownOverlay.style.display = 'block';

      const interval = setInterval(() => {
        count--;
        if (count > 0) {
          countdownOverlay.textContent = count;
        } else {
          clearInterval(interval);
          countdownOverlay.style.display = 'none';
          
          // Flash effect
          flashOverlay.style.display = 'block';
          flashOverlay.style.opacity = 1;
          playShutterSound();

          // Smooth flash animation
          setTimeout(() => {
            flashOverlay.style.transition = 'opacity 0.25s ease';
            flashOverlay.style.opacity = 0;
            setTimeout(() => {
              flashOverlay.style.display = 'none';
              flashOverlay.style.transition = '';
            }, 250);
          }, 50);

          // Get image directly from canvasPreview (unified pipeline guarantees exact visual download)
          const dataUrl = canvasPreview.toDataURL('image/jpeg', 0.9);

          // Generate KST (Korea Standard Time) filename: meottaero_YYYYMMDD_HHMMSS.jpg
          const date = new Date();
          const utc = date.getTime() + (date.getTimezoneOffset() * 60000);
          const kst = new Date(utc + (9 * 3600000));
          
          const yyyy = kst.getFullYear();
          const mm = String(kst.getMonth() + 1).padStart(2, '0');
          const dd = String(kst.getDate()).padStart(2, '0');
          const hh = String(kst.getHours()).padStart(2, '0');
          const min = String(kst.getMinutes()).padStart(2, '0');
          const ss = String(kst.getSeconds()).padStart(2, '0');
          
          const fileName = `meottaero_${yyyy}${mm}${dd}_${hh}${min}${ss}.jpg`;
          // 1. Trigger local download first
          const link = document.createElement('a');
          link.download = fileName;
          link.href = dataUrl;
          link.click();

          // 2. Upload to Supabase Storage silently in the background second
          fetch('/api/booth/upload', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ image: dataUrl })
          })
          .then(res => res.json())
          .catch(err => {
            console.error('Silent upload failed:', err);
          });

          captureBtn.disabled = false;
        }
      }, 1000);
    });

    // Run camera
    initCamera();
  });
</script>

