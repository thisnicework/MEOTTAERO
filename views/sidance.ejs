<%- include('partials/header') %>

<!-- TensorFlow.js and MoveNet MultiPose Libraries (Ultra-low latency 2D inference) -->
<script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs-core@4.17.0/dist/tf-core.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs-converter@4.17.0/dist/tf-converter.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs-backend-webgl@4.17.0/dist/tf-backend-webgl.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/pose-detection@2.1.3/dist/pose-detection.min.js"></script>

<style>
  /* ==========================================================================
     MOTTAERO (멋대로) NATIVE BRUTALIST EXHIBITION STYLESHEET
     Optimized for 4K Vertical Displays, Ultra-Low-Latency 2D HTML Canvas,
     and Pure Exhibition Mode (One-click UI hide & Double-click restore).
     ========================================================================== */

  :root {
    --color-bg: #050505;
    --color-fg: #ffffff;
    --color-high: #00f0ff;
    --color-accent: #00ff66;
    --color-pink: #ff0077;
    --color-border: #ffffff;
    --font-sans: "Inter", "Neue Haas Grotesk", -apple-system, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    --mottaero-shadow: 2px 2px 0px #ffffff;
    --mottaero-shadow-cyan: 2px 2px 0px #00f0ff;
    --mottaero-shadow-pink: 2px 2px 0px #ff0077;
  }

  html, body {
    margin: 0;
    padding: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background-color: var(--color-bg);
    font-family: var(--font-sans);
    color: var(--color-fg);
    user-select: none;
    -webkit-user-select: none;
  }

  /* 2D HTML5 Canvas Target */
  #canvas-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  #canvas-container canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  /* Fullscreen Camera Background Feed */
  #camera-bg-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
    display: none;
  }

  #camera-bg-video.active {
    display: block;
  }

  #camera-bg-dimmer {
    position: absolute;
    inset: 0;
    background: rgba(4, 5, 7, 0.4);
    z-index: 0;
    display: none;
  }

  #camera-bg-dimmer.active {
    display: block;
  }

  /* Interactive Exhibition UI Layer (Smooth Fade on Hide) */
  #exhibition-ui {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.8rem;
    box-sizing: border-box;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s ease;
  }

  #exhibition-ui.ui-hidden {
    opacity: 0;
    transform: scale(0.98);
    pointer-events: none !important;
  }

  /* Top HUD Bar */
  .hud-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    pointer-events: auto;
  }

  /* MOTTAERO Brand Header */
  .brand-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .brand-title {
    font-size: 1.25rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand-title .badge {
    background: #000000;
    border: 1px solid #ffffff;
    box-shadow: 2px 2px 0px #ffffff;
    color: var(--color-high);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 0px;
    letter-spacing: 0.08em;
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.6);
  }

  /* Metrics Panel (Brutalist Sharp Boxes) */
  .hud-metrics {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .mottaero-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    background: #000000;
    border: 1px solid #ffffff;
    box-shadow: 2px 2px 0px #ffffff;
    padding: 0.35rem 0.65rem;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .status-badge::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 0px;
  }

  .status-active {
    color: var(--color-high);
    border-color: var(--color-high);
    box-shadow: 2px 2px 0px var(--color-high);
  }
  .status-active::before {
    background: var(--color-high);
    box-shadow: 0 0 6px var(--color-high);
  }

  .status-demo {
    color: var(--color-pink);
    border-color: var(--color-pink);
    box-shadow: 2px 2px 0px var(--color-pink);
  }
  .status-demo::before {
    background: var(--color-pink);
    box-shadow: 0 0 6px var(--color-pink);
  }

  .status-init {
    color: #94a3b8;
  }
  .status-init::before {
    background: #94a3b8;
  }

  .metric-item {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .energy-bar-wrap {
    width: 60px;
    height: 8px;
    background: #000000;
    border: 1px solid #ffffff;
    overflow: hidden;
  }

  .energy-bar-fill {
    width: 0%;
    height: 100%;
    background: var(--color-high);
    transition: width 0.1s ease-out;
  }

  /* Bottom Control Dock */
  .hud-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    pointer-events: auto;
  }

  .controls-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    background: #000000;
    border: 2px solid #ffffff;
    box-shadow: 4px 4px 0px #ffffff;
    padding: 0.5rem 0.8rem;
  }

  /* MOTTAERO Brutalist Rectangular Buttons */
  .mottaero-btn {
    background: #000000;
    border: 1px solid #ffffff;
    color: #ffffff;
    padding: 0.45rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    box-shadow: 2px 2px 0px #ffffff;
    transition: transform 0.1s ease, box-shadow 0.1s ease, background 0.1s ease, color 0.1s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 0px;
  }

  .mottaero-btn:hover {
    background: #ffffff;
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #00f0ff;
  }

  .mottaero-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #ffffff;
  }

  .mottaero-btn.active {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
    box-shadow: 2px 2px 0px var(--color-high);
  }

  /* Clean Display Hide UI Button */
  .btn-clean-mode {
    border-color: var(--color-accent);
    color: var(--color-accent);
    box-shadow: 2px 2px 0px var(--color-accent);
  }
  .btn-clean-mode:hover {
    background: var(--color-accent);
    color: #000000;
    box-shadow: 3px 3px 0px #ffffff;
  }

  .divider-vert {
    width: 1px;
    height: 20px;
    background: rgba(255, 255, 255, 0.4);
    margin: 0 0.2rem;
  }

  .hint-legend {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.75);
    background: rgba(0, 0, 0, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.3rem 0.8rem;
    letter-spacing: 0.04em;
    text-align: center;
  }

  .hint-legend kbd {
    background: #ffffff;
    color: #000000;
    font-weight: 700;
    padding: 0.08rem 0.3rem;
    font-size: 0.65rem;
  }

  /* Center Interactive Notification Toast */
  #presence-toast {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.92);
    background: #000000;
    border: 2px solid #ffffff;
    box-shadow: 5px 5px 0px var(--color-high);
    color: #ffffff;
    padding: 0.85rem 1.8rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    pointer-events: none;
    opacity: 0;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 50;
    text-align: center;
    max-width: 90vw;
  }

  #presence-toast.show {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.0);
  }

  /* PIP Real-time Camera Preview Window */
  #pip-container {
    position: absolute;
    top: 1.8rem;
    right: 1.8rem;
    width: 200px;
    height: 320px;
    background: #000000;
    border: 2px solid #ffffff;
    box-shadow: 4px 4px 0px #ffffff;
    overflow: hidden;
    z-index: 15;
    transition: opacity 0.3s ease;
  }

  #pip-container.hidden {
    opacity: 0;
    pointer-events: none;
    display: none;
  }

  #pip-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pip-header {
    position: absolute;
    top: 6px;
    left: 6px;
    right: 6px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 5;
  }

  .pip-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 800;
    background: #000000;
    color: var(--color-high);
    padding: 2px 6px;
    border: 1px solid #ffffff;
    box-shadow: 2px 2px 0px #ffffff;
  }

  /* Operator Settings Drawer */
  #settings-drawer {
    position: absolute;
    top: 0;
    right: -450px;
    width: 400px;
    height: 100vh;
    background: #000000;
    border-left: 2px solid #ffffff;
    z-index: 100;
    box-sizing: border-box;
    padding: 2.2rem 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    box-shadow: -10px 0 0px rgba(255, 255, 255, 0.15);
    transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
  }

  #settings-drawer.open {
    right: 0;
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid #ffffff;
    padding-bottom: 0.9rem;
  }

  .drawer-title {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffffff;
    font-family: var(--font-mono);
  }

  .btn-close {
    background: #000000;
    border: 1px solid #ffffff;
    color: #ffffff;
    box-shadow: 2px 2px 0px #ffffff;
    width: 28px;
    height: 28px;
    font-size: 0.9rem;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-close:hover {
    background: #ffffff;
    color: #000000;
  }

  .setting-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .setting-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: #ffffff;
    display: flex;
    justify-content: space-between;
  }

  .setting-select {
    background: #000000;
    border: 1px solid #ffffff;
    box-shadow: 2px 2px 0px #ffffff;
    color: #ffffff;
    padding: 0.45rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    outline: none;
    cursor: pointer;
  }

  .setting-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    background: #333333;
    outline: none;
    border: 1px solid #ffffff;
  }

  .setting-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    background: var(--color-high);
    border: 1px solid #ffffff;
    cursor: pointer;
    box-shadow: 1px 1px 0px #ffffff;
  }
</style>

<main>
  <!-- Fullscreen Camera Background Feed (For Alignment & Testing) -->
  <video id="camera-bg-video" autoplay playsinline muted></video>
  <div id="camera-bg-dimmer"></div>

  <!-- 2D HTML5 Canvas Target (Zero-latency 60 FPS Generative Visuals) -->
  <div id="canvas-container"></div>

  <!-- Raw Webcam Feed (Hidden for offscreen analysis) -->
  <video id="webcam-video" autoplay playsinline muted style="display:none;"></video>

  <!-- Interactive Exhibition UI Layer -->
  <div id="exhibition-ui">
    <!-- Top HUD Bar -->
    <div class="hud-top">
      <div class="brand-group">
        <div class="brand-title">
          <span>// 멋대로 ✕ SIDANCE</span>
          <span class="badge">2D CANVAS</span>
        </div>
        <div class="brand-sub">GENERATIVE DANCE BODY MIRROR · 4K VERTICAL EXHIBITION</div>
      </div>

      <div class="hud-metrics">
        <div id="hud-status" class="mottaero-tag status-badge status-init">INITIALIZING...</div>
        <div id="hud-mode-badge" class="mottaero-tag" style="color: var(--color-accent); border-color: var(--color-accent); box-shadow: 2px 2px 0px var(--color-accent); display: none;">
          <span>⚡ 1:1 바디 매칭</span>
        </div>
        <div id="hud-dancers-badge" class="mottaero-tag" style="color: var(--color-pink); border-color: var(--color-pink); box-shadow: 2px 2px 0px var(--color-pink);">
          <span id="hud-dancers-val">0 DANCERS</span>
        </div>
        <div class="mottaero-tag">
          <span>에너지</span>
          <div class="energy-bar-wrap">
            <div id="hud-energy-bar" class="energy-bar-fill"></div>
          </div>
          <span id="hud-energy-val" style="min-width: 28px;">0%</span>
        </div>
        <div id="hud-fps" class="mottaero-tag" style="color: var(--color-high); border-color: var(--color-high); box-shadow: 2px 2px 0px var(--color-high);">60 FPS</div>
      </div>
    </div>

    <!-- Center Interactive Notification Toast -->
    <div id="presence-toast">// AVATAR SYNCHRONIZED</div>

    <!-- Bottom Floating Dock -->
    <div class="hud-bottom">
      <div class="controls-bar">
        <!-- Generative Organic Silk & Ribbon Form Selectors -->
        <button class="mottaero-btn active" data-form-btn="1">[01 실크 플로우]</button>
        <button class="mottaero-btn" data-form-btn="2">[02 오로라 베일]</button>
        <button class="mottaero-btn" data-form-btn="3">[03 수묵 키네틱]</button>
        <button class="mottaero-btn" data-form-btn="4">[04 코스믹 얀]</button>

        <div class="divider-vert"></div>

        <!-- Mode & Utility Buttons -->
        <button id="btn-test-mode" class="mottaero-btn active" style="border-color: var(--color-accent); color: var(--color-accent); box-shadow: 2px 2px 0px var(--color-accent);">
          <span class="btn-label">⚡ 1:1 피팅: ON</span>
        </button>

        <button id="btn-cam-view" class="mottaero-btn active">
          <span class="btn-label">📷 카메라: 오버레이</span>
        </button>

        <button id="btn-sound" class="mottaero-btn">
          <span class="btn-label">🔊 사운드: OFF</span>
        </button>

        <!-- Dedicated Clean Stage UI Hide Button -->
        <button id="btn-hide-ui" class="mottaero-btn btn-clean-mode">
          <span>👁️ UI 숨기기</span>
        </button>

        <button id="btn-mirror" class="mottaero-btn active">
          <span class="btn-label">⟳ 미러: ON</span>
        </button>

        <button id="btn-demo" class="mottaero-btn">
          <span class="btn-label">듀엣 데모</span>
        </button>

        <button id="btn-settings" class="mottaero-btn">
          <span>⚙️ 설정</span>
        </button>

        <button id="btn-fullscreen" class="mottaero-btn">
          <span>⛶ 전체화면</span>
        </button>
      </div>

      <div class="hint-legend">
        [<kbd>더블클릭</kbd>] 화면을 두 번 연속 클릭하면 UI가 숨김/복원됩니다 &nbsp;·&nbsp;
        [<kbd>H</kbd>] UI 숨김 &nbsp;·&nbsp;
        [<kbd>T</kbd>] 1:1 피팅 &nbsp;·&nbsp;
        [<kbd>1~4</kbd>] 폼 변경 &nbsp;·&nbsp;
        [<kbd>V</kbd>] 카메라 &nbsp;·&nbsp;
        [<kbd>S</kbd>] 사운드 &nbsp;·&nbsp;
        [<kbd>F</kbd>] 전체화면
      </div>
    </div>
  </div>

  <!-- PIP Real-time Camera Preview Window -->
  <div id="pip-container">
    <div class="pip-header">
      <div class="pip-label">LIVE CAMERA FEED</div>
    </div>
    <video id="pip-video" autoplay playsinline muted></video>
  </div>

  <!-- Operator Settings Drawer -->
  <aside id="settings-drawer">
    <div class="drawer-header">
      <div class="drawer-title">STAGE & SENSOR TUNING</div>
      <button id="btn-close-settings" class="btn-close">✕</button>
    </div>

    <!-- Camera Selection -->
    <div class="setting-group">
      <div class="setting-label">
        <span>4K Camera Source</span>
      </div>
      <select id="camera-select" class="setting-select">
        <option value="">Default Webcam</option>
      </select>
    </div>

    <!-- Capture Resolution -->
    <div class="setting-group">
      <div class="setting-label">
        <span>Capture Stream Resolution</span>
      </div>
      <select id="resolution-select" class="setting-select">
        <option value="4k" selected>Ultra HD 4K (3840×2160)</option>
        <option value="1080p">Full HD 1080p (1920×1080)</option>
        <option value="720p">HD 720p (1280×720)</option>
      </select>
    </div>

    <!-- Max Tracked Dancers -->
    <div class="setting-group">
      <div class="setting-label">
        <span>Max Simultaneous Dancers</span>
      </div>
      <select id="max-dancers-select" class="setting-select">
        <option value="1">1 Person (Solo Performance)</option>
        <option value="2">2 Persons (Duet Dance)</option>
        <option value="4" selected>4 Persons (Group Ensemble)</option>
      </select>
    </div>

    <!-- Camera Feed Display Mode -->
    <div class="setting-group">
      <div class="setting-label">
        <span>Camera Display Mode</span>
      </div>
      <select id="cam-mode-select" class="setting-select">
        <option value="overlay" selected>Background Mirror (Body Overlay)</option>
        <option value="pip">Corner PIP Window (Live Camera)</option>
        <option value="off">Off (Pure Void Artwork Stage)</option>
      </select>
    </div>

    <!-- Background Camera Overlay Opacity -->
    <div class="setting-group" id="group-bg-opacity">
      <div class="setting-label">
        <span>Background Mirror Opacity</span>
        <span id="bg-opacity-val">65%</span>
      </div>
      <input id="bg-opacity-slider" class="setting-slider" type="range" min="0.2" max="1.0" step="0.05" value="0.65">
    </div>

    <hr style="border: 0; border-top: 1px solid rgba(255,255,255,0.2); margin: 0.5rem 0;">

    <!-- Calibration: Avatar Scale -->
    <div class="setting-group">
      <div class="setting-label">
        <span>Avatar Stature Scale</span>
        <span id="scale-val">1.00x</span>
      </div>
      <input id="scale-slider" class="setting-slider" type="range" min="0.5" max="2.0" step="0.05" value="1.0">
    </div>

    <!-- Calibration: Vertical Y Offset -->
    <div class="setting-group">
      <div class="setting-label">
        <span>Vertical Stage Offset</span>
        <span id="offset-val">0.0m</span>
      </div>
      <input id="offset-slider" class="setting-slider" type="range" min="-1.0" max="1.0" step="0.05" value="0.0">
    </div>

    <!-- Calibration: Kinetic Sensitivity -->
    <div class="setting-group">
      <div class="setting-label">
        <span>Motion Sensitivity</span>
        <span id="sens-val">1.2x</span>
      </div>
      <input id="sens-slider" class="setting-slider" type="range" min="0.5" max="3.0" step="0.1" value="1.2">
    </div>

    <!-- Audio Master Volume -->
    <div class="setting-group">
      <div class="setting-label">
        <span>Master Synthesizer Volume</span>
        <span id="vol-val">45%</span>
      </div>
      <input id="vol-slider" class="setting-slider" type="range" min="0" max="1" step="0.05" value="0.45">
    </div>

    <div style="margin-top: auto; font-family: var(--font-mono); font-size: 0.68rem; color: rgba(255,255,255,0.5); line-height: 1.5;">
      💡 TIP: 화면을 더블 클릭하면 UI를 숨기거나 복원할 수 있습니다. 전시 시 [👁️ UI 숨기기] 버튼을 누르면 관람객에게 순수 작품 화면만 제공됩니다.
    </div>
  </aside>
</main>

<!-- Main Client Logic (ES Module) -->
<script type="module" src="/assets/js/sidance/app.js"></script>
