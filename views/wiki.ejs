<%- include('partials/header') %>

<style>
  /* Back Button for mobile viewports */
  .wiki-back-btn {
    display: none;
  }
  @media (max-width: 59.938em) {
    .wiki-back-btn {
      display: inline-block;
      margin-bottom: 1.5rem;
      font-weight: bold;
      text-decoration: underline;
      cursor: pointer;
      color: var(--color-fg);
      font-size: 0.9rem;
    }
  }

  /* Right Wiki Content Inner Wrappers */
  .wiki-content {
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    padding-bottom: 2rem;
  }

  .wiki-window-header {
    border-bottom: 1px solid var(--color-fg);
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 1.25rem;
    font-weight: bold;
    color: var(--color-fg);
  }

  .wiki-window-body {
    flex: 1;
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--color-fg);
    overflow-y: auto;
  }

  .wiki-window-body p {
    margin-bottom: 1rem;
  }

  .wiki-window-body ul {
    margin-left: 1.2rem;
    margin-bottom: 1rem;
    list-style-type: disc;
  }

  .wiki-window-body li {
    margin-bottom: 0.5rem;
  }

  /* Active Sidebar highlighting utilizing site green */
  main a.article-item.block.active h2 {
    color: var(--color-high);
  }
</style>

<main class="fixed">
  <!-- Left Side: Directory Sidebar Section -->
  <section id="one" class="left" aria-expanded="true">
    <div class="wiki-sidebar-list" style="margin-top: 1rem;">
      <!-- Title header matching semesters / students lists -->
      <div style="border-bottom: 1px solid var(--color-fg); padding-bottom: 0.5rem; margin-bottom: 1.5rem; font-weight: bold; font-size: 0.9rem; color: var(--color-fg); letter-spacing: 0.05em;">
        // TRIVIA & PAPERS DATABASE
      </div>
      
      <!-- List matching semesters / students native anchors -->
      <div class="articles">
        <a class="article-item block active" data-article="sys_index" style="cursor: pointer;">
          <h2 class="bold">소개 (INDEX)</h2>
        </a>
        <a class="article-item block" data-article="ark_philosophy" style="cursor: pointer;">
          <h2 class="bold">[01] 방주의 철학</h2>
        </a>
        <a class="article-item block" data-article="first_bug" style="cursor: pointer;">
          <h2 class="bold">[02] 최초의 버그</h2>
        </a>
        <a class="article-item block" data-article="noise_frequency" style="cursor: pointer;">
          <h2 class="bold">[03] 소음과 우주 주파수</h2>
        </a>
        <a class="article-item block" data-article="body_vectors" style="cursor: pointer;">
          <h2 class="bold">[04] 신체와 벡터</h2>
        </a>
        <a class="article-item block" data-article="analog_superposition" style="cursor: pointer;">
          <h2 class="bold">[05] 0과 1 사이의 아날로그</h2>
        </a>
        <a class="article-item block" data-article="engineering_papers" style="cursor: pointer;">
          <h2 class="bold">[06] 관련 공학 논문</h2>
        </a>
      </div>
    </div>
  </section>

  <!-- Right Side: Content Section -->
  <section id="two" class="right" aria-expanded="false">
    <!-- Back to directory button for mobile viewports -->
    <a class="wiki-back-btn" id="wiki-back-btn">&larr; BACK TO DIRECTORY</a>

    <div class="wiki-content">
      <!-- Upper title header -->
      <div class="wiki-window-header" id="wiki-window-title">
        소개 (INDEX)
      </div>

      <!-- Main Text Body -->
      <div class="wiki-window-body" id="wiki-window-body">
        <!-- Renders dynamically -->
      </div>
    </div>
  </section>
</main>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const termBody = document.getElementById('wiki-window-body');
    const termTitle = document.getElementById('wiki-window-title');
    const articleItems = document.querySelectorAll('.article-item');
    const backBtn = document.getElementById('wiki-back-btn');
    const sectionOne = document.getElementById('one');
    const sectionTwo = document.getElementById('two');

    const titles = {
      sys_index: '소개 (INDEX)',
      ark_philosophy: '[01] 방주의 철학 (Philosophy of the Ark)',
      first_bug: '[02] 최초의 버그 (The First Computer Bug)',
      noise_frequency: '[03] 소음과 우주 주파수 (Noise & Cosmic Frequency)',
      body_vectors: '[04] 신체와 벡터 (Body Movements & Physical Vectors)',
      analog_superposition: '[05] 0과 1 사이의 아날로그 (Between 0 and 1: Analog Superposition)',
      engineering_papers: '[06] 관련 공학 논문 아카이브 (Related Engineering Papers)'
    };

    // Leaked DB Articles
    const articles = {
      sys_index: `
        <p>멋대로(MEOTTAERO) 크루 및 미디어 아트, 컴퓨터 과학에 얽힌 흥미롭고 기묘하며 알아두면 은근히 신비한 잡학사전 데이터베이스입니다.</p>
        <p>춤, 몸짓, 음악과 기술을 연결하는 학술적 연구 성과 및 배경 철학들을 제공합니다. 좌측 목차에서 원하시는 문서를 선택하여 읽어보실 수 있습니다.</p>
      `,

      ark_philosophy: `
        <p>크루 멋대로의 시그니처 갤러리 ⟪방주: HETEROTOPIA⟫는 프랑스의 철학자 미셸 푸코(Michel Foucault)가 1967년에 정의한 '헤테로토피아' 개념에서 영감을 받았습니다.</p>
        <ul>
          <li><strong>유토피아와 헤테로토피아:</strong> 유토피아가 실제로 존재하지 않는 이상향의 세계라면, 헤테로토피아는 현실에 분명 실존하는 '다른 규칙을 적용받는 물리 공간'입니다. 감옥, 요양원, 혹은 거울 너머의 공간처럼 사회의 정상적인 규칙에서 이탈하여 고유의 삶의 법칙이 흘러가는 장소가 이에 해당합니다.</li>
          <li><strong>가상 방주 공간:</strong> 멋대로는 이 개념을 디지털 가상 갤러리로 확장하여, 웹캠과 사진 아카이빙을 바탕으로 현실을 거울처럼 반사하되 완전히 격리된 가상 공간을 구축했습니다. 이곳에 아카이빙된 관객들의 얼굴은 가상 세계 속에서 일탈적 흔적으로 남겨지게 됩니다.</li>
        </ul>
      `,

      first_bug: `
        <p>현재 소프트웨어 개발 분야에서 매일같이 사용하는 '버그(Bug)'와 '디버그(Debug)'라는 용어는 단순한 수사적 비유가 아니라 컴퓨터 하드웨어 역사 속 실제 나방의 발견에서 유래했습니다.</p>
        <ul>
          <li><strong>진짜 나방의 발견:</strong> 1947년 9월 9일, 컴퓨터 과학의 개척자 그레이스 호퍼(Grace Hopper) 대위 연구팀은 하버드 대학교의 마크 II(Harvard Mark II) 컴퓨터가 고장을 일으키자 원인 규명에 나섰습니다. 계전기 70번 구역을 조사하던 도중 접점 사이에 끼어 죽어 있던 '실제 나방(Moth)' 한 마리를 발견했습니다.</li>
          <li><strong>용어의 탄생:</strong> 그들은 나방 사체를 핀셋으로 조심스럽게 꺼내 작업 일지에 접착테이프로 붙인 뒤, <em>"First actual case of bug being found" (실제 벌레가 발견된 최초의 사례)</em>라고 적었습니다. 이 사건 이후 시스템의 오동작을 '버그'라 칭하고, 이를 해결하는 과정을 '디버그'라고 부르기 시작했습니다.</li>
        </ul>
      `,

      noise_frequency: `
        <p>소리와 주파수는 단순히 청각적 즐거움을 넘어 물리학 및 신비주의 영역에서도 흥미로운 소재입니다.</p>
        <ul>
          <li><strong>표준 주파수 440Hz:</strong> 전 세계 오케스트라와 표준 음계 기준 A(라)음은 440Hz입니다. 하지만 일부 음악 치료사 및 주파수 신비주의자들은 A=432Hz가 자연의 고유 진동수 및 피보나치 수열과 유기적으로 일치하는 우주의 조율 주파수라고 주장합니다.</li>
          <li><strong>음모론과 미디어 아트:</strong> 440Hz 표준 조율이 나치에 의해 인간의 정서를 통제할 목적으로 널리 보급되었다는 역사적 음모론이 떠돌기도 합니다. 과학적 근거는 부족하지만, 많은 미디어 아티스트들이 432Hz 주파수와 아날로그 신디사이저 노이즈를 결합하여 명상적인 오디오 비주얼 구조를 설계하는 실험을 지속해오고 있습니다.</li>
        </ul>
      `,

      body_vectors: `
        <p>멋대로의 핵심 키워드인 '안무'와 '몸짓'은 컴퓨터 시스템의 시각(Computer Vision)으로 볼 때 입체적인 벡터 필드(Vector Field)의 질량 모멘텀 연산식으로 재구성됩니다.</p>
        <ul>
          <li><strong>속도 벡터 추출:</strong> 무용수가 팔다리를 뻗어 움직일 때, 카메라 트래킹 알고리즘(Optical Flow)은 신체 실루엣 좌표의 변화율을 미분하여 실시간 속도 벡터를 추출합니다: V = (dx/dt, dy/dt).</li>
          <li><strong>물리 조이스틱화:</strong> 이렇게 계산된 움직임의 크기와 방향 데이터(벡터)는 가상 3D 공간 상에 흩뿌려진 입자(Particle)나 선에 에너지를 부여하는 외력으로 작용합니다. 이를 통해 무용수의 신체 자체가 가상의 붓이자 하나의 거대한 물리 조이스틱처럼 작동하여 미디어 아트를 형성하게 됩니다.</li>
        </ul>
      `,

      analog_superposition: `
        <p>컴퓨터 시스템은 전류가 통하는 상태(1)와 차단된 상태(0)만을 식별하는 완고한 이진법 세계관에 기초합니다.</p>
        <ul>
          <li><strong>아날로그의 중첩:</strong> 현실의 자연과 인간의 정서는 0과 1 사이에 무수히 많은 미세 상태, 즉 아날로그적 중첩(Superposition) 상태로 존재합니다.</li>
          <li><strong>불완전함의 미학:</strong> 최근의 양자 컴퓨터가 0이자 동시에 1인 양자 중첩 상태를 기술적으로 활용하려고 하는 한편, 예술 영역에서는 완벽하지 않은 붓 터치, 혹은 연주 과정에서 발생하는 미세한 인간적 오차(Human Feel)가 0과 1 사이의 불완전함을 증명합니다. 기계적인 완벽함에서 벗어난 바로 그 지점에 예술의 가치가 존재합니다.</li>
        </ul>
      `,

      engineering_papers: `
        <p>춤, 몸짓(Gesture), 음악(Music)의 상호작용 및 실시간 매핑 기술을 다룬 대표적인 학술 연구 및 참조 논문 리스트입니다.</p>
        <ul>
          <li><strong>1. Gestural Control of Sound Synthesis (소리 합성의 제스처 제어)</strong>
            <br>- 저자: Marcelo M. Wanderley, Marc Battier (2001)
            <br>- 학회/저널: NIME (New Interfaces for Musical Expression)
            <br>- 요약: 무용수의 실시간 신체 모션 데이터를 소리 합성 정보로 매핑(Mapping)하는 기초 제어 모델 및 무선 센서 가이드라인을 정립한 기념비적인 최초의 연구입니다.
          </li>
          <li style="margin-top: 1rem;"><strong>2. Computer Vision Methods for Choreographic Analysis (안무 분석을 위한 컴퓨터 비전 기법)</strong>
            <br>- 저자: Christian Latulipe, David Wilson (2010)
            <br>- 학회/저널: IEEE Transactions on Visualization and Computer Graphics
            <br>- 요약: 비디오 카메라 피드에서 광학 흐름(Optical Flow)과 경계 상자를 활용하여 무용수의 무게 중심 이동 및 도약 동작을 정량화하고 시각 효과와 실시간 매칭하는 알고리즘을 분석한 연구입니다.
          </li>
          <li style="margin-top: 1rem;"><strong>3. Interactive Machine Learning for Gestural Instrument Design (제스처 악기 설계를 위한 대화형 머신러닝)</strong>
            <br>- 저자: Rebecca Fiebrink (2011)
            <br>- 학회/저널: MIT Press / Computer Music Journal
            <br>- 요약: 복잡한 물리 수식 코딩 없이, 사용자의 모션 동작을 인공지능 분류/회귀 알고리즘으로 즉석 학습시켜 신체 몸짓을 신디사이저 연주 악기 신호로 자동 변환하는 Wekinator 프레임워크 설계 논문입니다.
          </li>
          <li style="margin-top: 1rem;"><strong>4. Designing Interactive Dance Performance Systems: A Review of Technology and Aesthetics (인터랙티브 댄스 퍼포먼스 시스템의 기술과 미학적 설계)</strong>
            <br>- 저자: Todd Winkler (1998)
            <br>- 학회/저널: ICMC (International Computer Music Conference)
            <br>- 요약: 무대 위의 무용수가 실시간 가상 음향 및 시각 시스템과 지연 없이 상호작용하기 위해 하드웨어 컨트롤러 처리 지연(Latency)을 30ms 이내로 단축하는 전산 분산 처리 아키텍처에 관한 기초 설계 연구입니다.
          </li>
        </ul>
      `
    };

    function loadArticle(id) {
      const titleText = titles[id] || '';
      const bodyContent = articles[id] || '';
      
      termTitle.innerHTML = titleText;
      termBody.innerHTML = bodyContent;
    }

    // Sidebar navigation trigger
    articleItems.forEach(item => {
      item.addEventListener('click', () => {
        articleItems.forEach(i => i.classList.remove('active'));
        item.classList.add('active');
        
        const id = item.getAttribute('data-article');
        loadArticle(id);

        // Mobile responsive toggle
        sectionOne.setAttribute('aria-expanded', 'false');
        sectionTwo.setAttribute('aria-expanded', 'true');
      });
    });

    // Mobile back navigation trigger
    backBtn.addEventListener('click', () => {
      sectionOne.setAttribute('aria-expanded', 'true');
      sectionTwo.setAttribute('aria-expanded', 'false');
    });

    // Load first article on start
    loadArticle('sys_index');
  });
</script>

<%- include('partials/footer') %>
