<%- include('partials/header') %>

<style>
  /* Back Button for mobile viewports */
  .wiki-back-btn {
    display: none;
  }
  @media (max-width: 59.938em) {
    .wiki-back-btn {
      display: inline-block;
      margin-bottom: 1.5rem;
      font-weight: bold;
      text-decoration: underline;
      cursor: pointer;
      color: var(--color-fg);
      font-size: 0.9rem;
    }
  }

  /* Right Wiki Content Inner Wrappers */
  .wiki-content {
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    padding-bottom: 2rem;
  }

  .wiki-window-header {
    border-bottom: 1px solid var(--color-fg);
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 1.25rem;
    font-weight: bold;
    color: var(--color-fg);
  }

  .wiki-window-body {
    flex: 1;
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--color-fg);
    overflow-y: auto;
  }

  .wiki-window-body p {
    margin-bottom: 1.2rem;
  }

  .wiki-window-body ul {
    margin-left: 1.2rem;
    margin-bottom: 1.2rem;
    list-style-type: disc;
  }

  .wiki-window-body li {
    margin-bottom: 0.6rem;
  }

  .paper-citation-block {
    background-color: #f9f9f9;
    border-left: 3px solid var(--color-fg);
    padding: 0.8rem 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .paper-citation-block table {
    width: 100%;
    border-collapse: collapse;
  }

  .paper-citation-block td {
    padding: 0.2rem 0;
    vertical-align: top;
  }

  .paper-citation-block td.label {
    width: 100px;
    font-weight: bold;
    color: var(--color-mid);
  }

  /* Active Sidebar highlighting utilizing site green */
  main a.article-item.block.active h2 {
    color: var(--color-high);
  }
</style>

<main class="fixed">
  <!-- Left Side: Directory Sidebar Section -->
  <section id="one" class="left" aria-expanded="true">
    <div class="wiki-sidebar-list" style="margin-top: 1rem;">
      <!-- List matching semesters / students native anchors (without numbers) -->
      <div class="articles">
        <a class="article-item block active" data-article="paper_wanderley" style="cursor: pointer;">
          <h2 class="bold">소리 합성의 제스처 제어</h2>
        </a>
        <a class="article-item block" data-article="paper_fiebrink" style="cursor: pointer;">
          <h2 class="bold">제스처 악기의 머신러닝</h2>
        </a>
        <a class="article-item block" data-article="paper_winkler" style="cursor: pointer;">
          <h2 class="bold">인터랙티브 댄스 시스템 설계</h2>
        </a>
        <a class="article-item block" data-article="paper_latulipe" style="cursor: pointer;">
          <h2 class="bold">안무 분석을 위한 컴퓨터 비전</h2>
        </a>
        <a class="article-item block" data-article="paper_waisvisz" style="cursor: pointer;">
          <h2 class="bold">손동작 기반 음향 제어</h2>
        </a>
        <a class="article-item block" data-article="paper_godoy" style="cursor: pointer;">
          <h2 class="bold">신체 움직임과 소리의 매핑</h2>
        </a>
        <a class="article-item block" data-article="paper_essl" style="cursor: pointer;">
          <h2 class="bold">모바일 센서 기반 실시간 오디오 매핑</h2>
        </a>
        <a class="article-item block" data-article="paper_elgammal" style="cursor: pointer;">
          <h2 class="bold">3차원 안무 동작 복원을 위한 비전 학습</h2>
        </a>
        <a class="article-item block" data-article="paper_dourish" style="cursor: pointer;">
          <h2 class="bold">가상 현실과 체화된 인지 기반 인터랙션</h2>
        </a>
        <a class="article-item block" data-article="paper_tanaka" style="cursor: pointer;">
          <h2 class="bold">생체 전극 신호 기반 음악적 표현 제어</h2>
        </a>
        <a class="article-item block" data-article="paper_curation" style="cursor: pointer;">
          <h2 class="bold">디지털 아트 전시에서의 상호작용 기획</h2>
        </a>
        <a class="article-item block" data-article="paper_production" style="cursor: pointer;">
          <h2 class="bold">디지털 라이브 퍼포먼스의 프로덕션 관리</h2>
        </a>
        <a class="article-item block" data-article="paper_vr_museum" style="cursor: pointer;">
          <h2 class="bold">가상 미술관의 큐레이션 및 관객 흐름 설계</h2>
        </a>
        <a class="article-item block" data-article="paper_engagement" style="cursor: pointer;">
          <h2 class="bold">인터랙티브 전시의 관객 참여형 행동 기획</h2>
        </a>
      </div>
    </div>
  </section>

  <!-- Right Side: Content Section -->
  <section id="two" class="right" aria-expanded="false">
    <!-- Back to directory button for mobile viewports -->
    <a class="wiki-back-btn" id="wiki-back-btn">&larr; BACK TO DIRECTORY</a>

    <div class="wiki-content">
      <!-- Upper title header -->
      <div class="wiki-window-header" id="wiki-window-title">
        소리 합성의 제스처 제어
      </div>

      <!-- Main Text Body -->
      <div class="wiki-window-body" id="wiki-window-body">
        <!-- Renders dynamically -->
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const termBody = document.getElementById('wiki-window-body');
      const termTitle = document.getElementById('wiki-window-title');
      const articleItems = document.querySelectorAll('.article-item');
      const backBtn = document.getElementById('wiki-back-btn');
      const sectionOne = document.getElementById('one');
      const sectionTwo = document.getElementById('two');

      const titles = {
        paper_wanderley: '소리 합성의 제스처 제어 (Gestural Control of Sound Synthesis)',
        paper_fiebrink: '제스처 악기의 머신러닝 (Interactive Machine Learning for Gestural Instrument Design)',
        paper_winkler: '인터랙티브 댄스 시스템 설계 (Designing Interactive Dance Performance Systems)',
        paper_latulipe: '안무 분석을 위한 컴퓨터 비전 (Computer Vision Methods for Choreographic Analysis)',
        paper_waisvisz: '손동작 기반 음향 제어 (The Handposture Instrument)',
        paper_godoy: '신체 움직임과 소리의 매핑 (Mapping Body Movement to Musical Sound)',
        paper_essl: '모바일 센서 기반 실시간 오디오 매핑 (Mobile Phone as a Musical Instrument)',
        paper_elgammal: '3차원 안무 동작 복원을 위한 비전 학습 (Learning Silhouette Features for 3D Pose Recovery)',
        paper_dourish: '가상 현실과 체화된 인지 기반 인터랙션 (Action-centric Interaction in Virtual Environments)',
        paper_tanaka: '생체 전극 신호 기반 음악적 표현 제어 (Biosensors for Musical Expression)',
        paper_curation: '디지털 아트 전시에서의 상호작용 기획 (Curation and Audience Interaction in Digital Art Exhibitions)',
        paper_production: '디지털 라이브 퍼포먼스의 프로덕션 관리 (Managing Digital Performance: Production and Curation Models)',
        paper_vr_museum: '가상 미술관의 큐레이션 및 관객 흐름 설계 (The Virtual Museum: Curation, Operation and User Experience)',
        paper_engagement: '인터랙티브 전시의 관객 참여형 행동 기획 (Designing for Audience Engagement in Interactive Performance)'
      };

      // Leaked DB Articles
      const articles = {
        paper_wanderley: `
          <div class="paper-citation-block">
            <table>
              <tr><td class="label">논문명</td><td><strong>Gestural Control of Sound Synthesis</strong></td></tr>
              <tr><td class="label">저자</td><td>Marcelo M. Wanderley, Marc Battier</td></tr>
              <tr><td class="label">발행기관</td><td>NIME (New Interfaces for Musical Expression)</td></tr>
              <tr><td class="label">발행연도</td><td>2001년</td></tr>
            </table>
          </div>
          <p><strong>[서론 및 연구 배경]</strong></p>
          <p>디지털 테크놀로지의 발전은 전통적인 악기가 지닌 물리적 진동 구조로부터 소리 합성 장치를 완전히 분리해 냈습니다. 그러나 이러한 분리는 연주자가 악기와의 신체적 상호작용을 통해 얻던 직관적인 표현력과 피드백의 상실이라는 새로운 과제를 낳았습니다. Marcelo Wanderley의 본 연구는 신체적 모션(제스처) 데이터를 전산적으로 획득하고, 이를 사운드 합성 파라미터로 체계적으로 매핑(Mapping)하는 모델을 제시함으로써 뉴 인터페이스 설계의 이론적 토대를 마련했습니다.</p>
          <p><strong>[공학적 매핑 아키텍처 및 방법론]</strong></p>
          <p>논문에서는 센서 장치에서 들어오는 저수준 입력 데이터(가속도, 각도, 압력 등)를 사운드 신디사이저의 고수준 파라미터(주파수, 필터 컷오프, FM 변조 지수 등)로 연결하는 다차원 매핑 매트릭스를 정의합니다. 구체적으로는 다음과 같은 네 가지 매핑 관계를 수학적으로 공식화합니다.</p>
          <ul>
            <li><strong>일대일(1:1) 매핑:</strong> 단일 센서의 출력이 단일 오디오 합성 변수를 제어하는 직관적 방식입니다. 변수 간 간섭이 없어 연주자가 조작하기 쉽지만 다차원적인 복합 음색 변조를 수행하기에는 표현력의 한계가 명확합니다.</li>
            <li><strong>일대다(1:N) 매핑:</strong> 하나의 신체 제스처(예: 팔을 들어 올리는 높이)가 오디오 신호의 볼륨, 로우패스 필터 주파수, 그리고 잔향(Reverb) 크기를 동시에 제어하여 단일 동작만으로도 고밀도의 사운드 공간 질감 변화를 이끌어내는 다차원 변조 기법입니다.</li>
            <li><strong>다대일(N:1) 매핑:</strong> 여러 센서의 입력값(예: 손가락 굽힘 센서들과 손목 기울기 센서의 조합)을 가중치 행렬을 통해 하나의 사운드 파라미터(예: 디스토션 양)로 수렴시킵니다. 이는 동작의 물리적 복잡성을 단일 매개변수로 추상화하여 악기의 저항감과 조작의 숙련도를 향상시킵니다.</li>
            <li><strong>다대다(N:M) 매핑:</strong> 다차원의 센서 입력을 중간 추상화 레이어를 거쳐 다차원의 음향 합성 엔진 매개변수로 결합 전송하는 복합 아키텍처입니다. 연주자와 가상 악기 간의 유기적인 긴밀도를 극대화하여 실제 어쿠스틱 악기에 필적하는 깊이 있는 연주 표현력을 제공합니다.</li>
          </ul>
          <p><strong>[학술적 기여 및 미디어 아트적 의의]</strong></p>
          <p>본 연구는 신체의 해부학적 관절 움직임과 공간 좌표 변화가 주파수 진동 영역과 실시간으로 결합하는 과정을 이론적으로 설명해 냈습니다. 센서 입력의 스케일링 필터링부터 소리 합성의 상호작용 규칙까지를 단계별 레이어로 분리함으로써, 현대 다감각 설치 미술 및 안무 트래킹 미디어 아트 퍼포먼스가 기술적으로 작동하는 핵심 구조를 제공합니다.</p>
        `,

        paper_fiebrink: `
          <div class="paper-citation-block">
            <table>
              <tr><td class="label">논문명</td><td><strong>Interactive Machine Learning for Gestural Instrument Design</strong></td></tr>
              <tr><td class="label">저자</td><td>Rebecca Fiebrink</td></tr>
              <tr><td class="label">발행기관</td><td>MIT Press / Computer Music Journal (Vol 35)</td></tr>
              <tr><td class="label">발행연도</td><td>2011년</td></tr>
            </table>
          </div>
          <p><strong>[서론 및 연구 배경]</strong></p>
          <p>기존의 센서 기반 인터랙티브 시스템 설계는 프로그래머가 센서 데이터의 세부 값 범위를 일일이 관찰하고 수십 줄의 하드코딩 조건문(if-else)을 통해 사운드 매개변수에 수동으로 할당하는 방식으로 구현되었습니다. 이러한 휴리스틱 설계 방식은 인간 동작의 유기적인 비선형성과 다차원성을 기계적 규칙에 억지로 끼워 맞추는 한계를 안고 있었습니다. Rebecca Fiebrink는 이를 극복하기 위해 머신러닝 알고리즘을 매핑 설계 과정에 대화형으로 개입시키는 '인터랙티브 머신러닝(IML)' 아키텍처를 창제하고 이를 소프트웨어 툴킷 Wekinator를 통해 학술적, 실용적으로 구현했습니다.</p>
          <p><strong>[기술 명세 및 AI 매핑 모델]</strong></p>
          <p>연구에서 제시하는 프레임워크는 예술가가 무대 인터페이스 장치(웹캠, 키네크트, 근전도 센서 등) 앞에서 직접 예시 동작을 수행하고 이에 어울리는 사운드 파라미터 결과값을 강제 매칭하여 동적으로 데이터셋을 구축하도록 지원합니다. 이 데이터셋을 바탕으로 실시간 학습을 수행하며 사용하는 머신러닝 모델은 다음과 같이 세분화됩니다.</p>
          <ul>
            <li><strong>인공신경망 회귀 모델 (ANN Regression):</strong> 연속적인 모션 데이터의 수치 흐름을 신디사이저의 다차원 연속 인자(예: 모듈레이션 주파수, 오실레이터 믹스 비율)에 실시간으로 보간 매핑합니다. 비선형적인 동작 가속도가 소리의 질감 영역으로 자연스럽게 결합되는 활성화 함수 매커니즘을 가집니다.</li>
            <li><strong>분류 알고리즘 모델 (KNN / SVM):</strong> 불연속적이거나 특정 범주에 대응하는 동작 형태를 명확히 판별하여 지정된 사운드 이벤트나 드럼 샘플링 재생 트리거로 변환합니다. 예컨대 손뼉을 치는 순간적인 피크 전압이나 주먹을 쥐는 이산적 변화를 실시간으로 가로채어 감지합니다.</li>
          </ul>
          <p><strong>[인간 중심 기계 학습 루프]</strong></p>
          <p>Fiebrink 교수의 가장 큰 학술적 기여는 머신러닝을 단순히 일방적인 예측 연산 엔진으로 쓰는 것을 넘어, '훈련 - 실행 - 데이터 수정 - 재훈련'으로 구성되는 인간-기계 상호작용 피드백 루프를 제안한 점입니다. 예술가는 AI가 오분류하거나 어색하게 사운드를 렌더링하는 특정 동작 구간에 대해 추가적인 훈련 데이터를 즉석에서 공급함으로써 코딩을 전혀 모르는 상태에서도 오직 물리적 훈련을 통해 지능형 동작 악기를 조율해 나갈 수 있게 됩니다.</p>
        `,

        paper_winkler: `
          <div class="paper-citation-block">
            <table>
              <tr><td class="label">논문명</td><td><strong>Designing Interactive Dance Performance Systems: A Review of Technology and Aesthetics</strong></td></tr>
              <tr><td class="label">저자</td><td>Todd Winkler</td></tr>
              <tr><td class="label">발행기관</td><td>ICMC (International Computer Music Conference)</td></tr>
              <tr><td class="label">발행연도</td><td>1998년</td></tr>
            </table>
          </div>
          <p><strong>[서론 및 연구 배경]</strong></p>
          <p>무대 위 무용예술과 뉴미디어 컴퓨팅의 융합은 무용수의 신체적 해방을 유도하는 동시에, 실시간 신호 제어 네트워크라는 전산 공학적 과제를 제시합니다. Todd Winkler는 1990년대 후반의 제한된 연산 성능 환경 하에서 무용수의 모션 신호를 오디오 음향 생성 장치로 지연 없이 전송하고, 이를 예술적 연출로 승화시키기 위해 고려해야 할 하드웨어 시스템 통합 모델과 상호작용 규칙(Aesthetics of Interaction)을 수립했습니다.</p>
          <p><strong>[시스템 아키텍처 및 신호 지연율 제어]</strong></p>
          <p>시스템은 무용수의 몸에 장착된 무선 센서(초기 가속도계, 굽힘 센서 등)와 무대 외곽에 위치한 전산 연산 장치(Max/MSP 패치 등) 간의 실시간 시리얼 데이터 전송 경로를 기반으로 합니다. 전산 연산 부하가 증가함에 따라 음향 합성에 신호 손실 및 지연이 발생하는 문제를 방지하기 위해 논문은 다음과 같은 최적화 모델을 분석합니다.</p>
          <ul>
            <li><strong>30ms 임계 지연 제어:</strong> 인간의 두뇌가 시각적 신체 움직임과 청각적 사운드 반응 사이의 물리적 인과관계를 단일한 사건(Event)으로 인지하기 위해 허용되는 최대 신호 전달 지연 시간은 30ms 이내여야 함을 전산 실험을 통해 증명해 냈습니다.</li>
            <li><strong>지연율 최적화:</strong> 무선 센서 데이터 수집율(Sample Rate)을 50Hz-100Hz 사이로 조율하고, 하드웨어 컨트롤러 보드의 버퍼 크기를 유동적으로 낮추어 무선 전송 노이즈 필터링과 전송 신속성 사이의 수학적 접점을 도출해 냈습니다.</li>
          </ul>
          <p><strong>[상호 순환 피드백 루프 모델]</strong></p>
          <p>Winkler 교수는 단순히 입력 동작을 트리거로 삼아 음악을 일방적으로 재생하는 수동적 매개 시스템을 비판합니다. 무용수가 무대에서 즉흥 안무를 수행하면 컴퓨터가 움직임의 크기와 속도를 실시간 분석해 소리를 변주하고, 변화된 소리(템포, 피치, 공간감)에 반응하여 무용수가 다시 춤의 다이내믹을 변화시키는 상호 작용적 순환 피드백 루프(Interactive Cybernetic Loop)를 구축해야 비로소 진정한 의미의 융합 예술이 성립됨을 밝혀냈습니다.</p>
        `,

        paper_latulipe: `
          <div class="paper-citation-block">
