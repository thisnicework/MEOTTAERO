<%- include('partials/header') %>

<style>
  :root {
    --color-high: rgb(25, 111, 61);
  }
  .archive-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem 1.5rem;
  }

  /* Title HUD Area */
  .archive-hud {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
    border-bottom: 2px solid var(--color-fg);
    padding-bottom: 1.2rem;
  }
  .archive-title {
    font-size: 1.8rem;
    font-weight: 900;
    letter-spacing: -0.5px;
    color: var(--color-fg);
    margin: 0;
  }

  /* Cards Grid Feed */
  .archive-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 992px) {
    .archive-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .archive-container {
      padding: 1rem 0.75rem 4rem 0.75rem;
    }
    .archive-hud {
      margin-bottom: 1.8rem;
      padding-bottom: 0.8rem;
    }
    .archive-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.8rem;
    }
    .archive-card {
      padding: 0.65rem;
      box-shadow: 3px 3px 0px rgba(0, 0, 0, 0.85);
    }
    .archive-card-header {
      font-size: 0.7rem;
      margin-bottom: 0.5rem;
    }
    .archive-card-text {
      font-size: 0.8rem;
      margin-bottom: 0.6rem;
    }
    .archive-card-footer {
      font-size: 0.65rem;
    }
  }

  @media (max-width: 480px) {
    .archive-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  /* Card Component Styling */
  .archive-card {
    background: #ffffff;
    border: 2px solid #000000;
    box-shadow: 5px 5px 0px rgba(0, 0, 0, 0.85);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    color: #000000;
    position: relative;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .archive-card:hover {
    transform: translateY(-3px);
    box-shadow: 8px 8px 0px var(--color-high);
  }
  .archive-card-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: bold;
    border-bottom: 1px solid #ddd;
    padding-bottom: 0.4rem;
    margin-bottom: 0.6rem;
    font-family: monospace;
    align-items: center;
  }
  .archive-card-badge {
    background: #000;
    color: #fff;
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
    font-size: 0.7rem;
  }
  .archive-card-photo {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border: 1px solid #000;
    margin-bottom: 0.6rem;
    cursor: pointer;
    background: #000;
    transition: filter 0.15s ease;
  }
  .archive-card-photo:hover {
    filter: brightness(0.9);
  }
  .archive-card-text {
    font-size: 0.85rem;
    line-height: 1.45;
    word-break: break-word;
    white-space: pre-wrap;
    margin-bottom: 0.75rem;
    flex-grow: 1;
  }
  .archive-card-footer {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    font-family: monospace;
    opacity: 0.75;
    border-top: 1px solid #eee;
    padding-top: 0.4rem;
  }

  /* Photo Detail Popup Modal (Lightbox) */
  .photo-modal {
    display: none;
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(5px);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .photo-modal.active {
    display: flex;
  }
  .photo-modal-content {
    background: #ffffff;
    border: 2px solid #000000;
    padding: 1.5rem;
    max-width: 580px;
    width: 100%;
    position: relative;
    box-shadow: 10px 10px 0 var(--color-high);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: #000000;
    animation: zoomIn 0.18s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes zoomIn {
    from { transform: scale(0.95); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  .photo-modal-close {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    background: none;
    border: none;
    font-size: 1.8rem;
    cursor: pointer;
    font-weight: bold;
    color: #000000;
    z-index: 10;
    line-height: 1;
  }
  .photo-modal-close:hover {
    color: var(--color-high);
  }
  .photo-modal-img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border: 1px solid #000000;
    background: #000;
  }
  .photo-modal-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .photo-modal-author {
    font-weight: bold;
    font-size: 1.05rem;
    color: var(--color-high);
    border-bottom: 1px dashed #ccc;
    padding-bottom: 0.4rem;
  }
  .photo-modal-text {
    font-size: 0.95rem;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .photo-modal-date {
    font-size: 0.75rem;
    font-family: monospace;
    opacity: 0.6;
    text-align: right;
  }
</style>

<div class="archive-container">
  <!-- Header HUD -->
  <div class="archive-hud">
    <h1 class="archive-title">// HETEROTOPIA ARCHIVE</h1>
  </div>

  <!-- Cards Grid Feed -->
  <div id="archive-grid" class="archive-grid">
    <div style="grid-column: 1 / -1; text-align: center; padding: 4rem; font-family: monospace; opacity: 0.5;">
      LOADING ARCHIVED CARDS...
    </div>
  </div>
</div>

<!-- Photo Lightbox Modal -->
<div id="photo-modal" class="photo-modal">
  <div class="photo-modal-content" onclick="event.stopPropagation()">
    <button id="photo-modal-close-btn" class="photo-modal-close">&times;</button>
    <img id="photo-modal-img" class="photo-modal-img" src="" alt="Enlarged Photo">
    <div class="photo-modal-info">
      <div id="photo-modal-author" class="photo-modal-author"></div>
      <div id="photo-modal-text" class="photo-modal-text"></div>
      <div id="photo-modal-date" class="photo-modal-date"></div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const grid = document.getElementById('archive-grid');
    const photoModal = document.getElementById('photo-modal');
    const photoModalImg = document.getElementById('photo-modal-img');
    const photoModalCloseBtn = document.getElementById('photo-modal-close-btn');
    const photoModalAuthor = document.getElementById('photo-modal-author');
    const photoModalText = document.getElementById('photo-modal-text');
    const photoModalDate = document.getElementById('photo-modal-date');

    let allCards = [];

    function formatKST(dateInput) {
      if (!dateInput) return '';
      const d = new Date(dateInput);
      if (isNaN(d.getTime())) return '';
      const formatter = new Intl.DateTimeFormat('sv-SE', {
        timeZone: 'Asia/Seoul',
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit', second: '2-digit',
        hour12: false
      });
      return formatter.format(d).replace(/-/g, '.');
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    async function loadArchive() {
      try {
        const res = await fetch('/api/heterotopia/cards');
        const data = await res.json();
        if (data.success && Array.isArray(data.cards)) {
          allCards = data.cards;
          renderArchive();
        }
      } catch (err) {
        console.error('Error loading archive cards:', err);
        grid.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; padding: 3rem; font-family: monospace; border: 1px dashed red;">아카이브 카드를 불러오는 중 오류가 발생했습니다.</div>';
      }
    }

    function renderArchive() {
      if (allCards.length === 0) {
        grid.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; padding: 4rem; font-family: monospace; opacity: 0.5;">등록된 방명록 카드가 없습니다.</div>';
        return;
      }

      // We need chronological sort to determine correct overall order index (#1, #2...)
      const chronoOrdered = [...allCards].sort((a, b) => new Date(a.createdAt || 0) - new Date(b.createdAt || 0));
      
      // Default to latest first
      const displayCards = [...allCards].sort((a, b) => {
        const timeA = new Date(a.createdAt || 0);
        const timeB = new Date(b.createdAt || 0);
        return timeB - timeA;
      });

      grid.innerHTML = '';
      displayCards.forEach((card) => {
        // Find index from chronological sort
        const orderNum = chronoOrdered.indexOf(card) + 1;
        const timeStr = formatKST(card.photoTakenAt || card.createdAt);

        const cardEl = document.createElement('div');
        cardEl.className = 'archive-card';

        cardEl.innerHTML = `
          <div class="archive-card-header">
            <span>// ${escapeHtml(card.author || '익명')}</span>
            <span class="archive-card-badge">#${orderNum}</span>
          </div>
          ${card.photo ? `<img class="archive-card-photo" src="${card.photo}" alt="Webcam Photo" data-photo="${card.photo}">` : ''}
          ${card.text ? `<div class="archive-card-text">${escapeHtml(card.text)}</div>` : ''}
          <div class="archive-card-footer">
            <span>${timeStr}</span>
            <span>HETEROTOPIA</span>
          </div>
        `;

        // Click on photo OR card to view details
        cardEl.addEventListener('click', function (e) {
          photoModalImg.src = card.photo || '';
          photoModalImg.style.display = card.photo ? 'block' : 'none';
          photoModalAuthor.textContent = `// ${escapeHtml(card.author || '익명')}`;
          photoModalText.textContent = card.text || '';
          photoModalDate.textContent = timeStr;
          photoModal.classList.add('active');
        });

        grid.appendChild(cardEl);
      });
    }

    // Close Modal Bindings
    photoModal.addEventListener('click', function () {
      photoModal.classList.remove('active');
    });

    if (photoModalCloseBtn) {
      photoModalCloseBtn.addEventListener('click', function () {
        photoModal.classList.remove('active');
      });
    }

    loadArchive();
  });
</script>

<%- include('partials/footer') %>
