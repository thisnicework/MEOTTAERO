<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIDANCE ✕ FUTURE YOU — 비디오 아카이브</title>
  <link rel="stylesheet" href="/assets/css/main.css">
  <style>
    :root {
      --bg-dark: #07090e;
      --card-bg: rgba(18, 22, 32, 0.75);
      --card-border: rgba(255, 255, 255, 0.12);
      --accent-cyan: #00e5ff;
      --accent-green: #00ff88;
      --text-main: #f0f4f8;
      --text-muted: #8a96a8;
      --font-mono: 'Space Mono', monospace, -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: -apple-system, BlinkMacSystemFont, 'Pretendard', sans-serif;
      min-height: 100vh;
      padding: 32px 24px 80px;
    }

    .archive-header {
      max-width: 1400px;
      margin: 0 auto 36px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--card-border);
    }

    .brand-section {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .brand-logo {
      height: 38px;
      width: auto;
      object-fit: contain;
    }

    .brand-title {
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: #fff;
    }

    .brand-sub {
      font-size: 0.85rem;
      font-family: var(--font-mono);
      color: var(--accent-cyan);
      margin-top: 2px;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 4px;
      font-size: 0.88rem;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s ease;
      border: 1px solid var(--card-border);
      background: rgba(255, 255, 255, 0.06);
      color: #fff;
    }

    .btn:hover {
      background: rgba(255, 255, 255, 0.14);
      border-color: rgba(255, 255, 255, 0.3);
      transform: translateY(-1px);
    }

    .btn-accent {
      background: rgba(0, 229, 255, 0.12);
      border-color: rgba(0, 229, 255, 0.4);
      color: var(--accent-cyan);
    }

    .btn-accent:hover {
      background: rgba(0, 229, 255, 0.22);
      border-color: var(--accent-cyan);
    }

    .stats-bar {
      max-width: 1400px;
      margin: 0 auto 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .video-grid {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
      gap: 28px;
    }

    .video-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .video-card:hover {
      transform: translateY(-3px);
      border-color: rgba(0, 229, 255, 0.35);
    }

    .video-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000;
    }

    .video-player {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .video-info {
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      flex: 1;
    }

    .video-name {
      font-family: var(--font-mono);
      font-size: 0.88rem;
      color: #fff;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .video-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .badge-size {
      background: rgba(255, 255, 255, 0.08);
      padding: 2px 6px;
      border-radius: 3px;
      color: #cbd5e1;
    }

    .video-actions {
      display: flex;
      gap: 8px;
      margin-top: 4px;
    }

    .action-btn {
      flex: 1;
      text-align: center;
      padding: 8px 12px;
      font-size: 0.8rem;
      font-family: var(--font-mono);
      border-radius: 4px;
      text-decoration: none;
      cursor: pointer;
      border: 1px solid var(--card-border);
      background: rgba(255, 255, 255, 0.04);
      color: #cbd5e1;
      transition: all 0.15s ease;
    }

    .action-btn:hover {
      background: rgba(255, 255, 255, 0.12);
      color: #fff;
    }

    .action-btn.btn-play {
      background: rgba(0, 255, 136, 0.1);
      border-color: rgba(0, 255, 136, 0.3);
      color: var(--accent-green);
    }

    .action-btn.btn-play:hover {
      background: rgba(0, 255, 136, 0.2);
    }

    .action-btn.btn-delete {
      background: rgba(255, 60, 60, 0.08);
      border-color: rgba(255, 60, 60, 0.25);
      color: #ff6b6b;
      flex: 0 0 auto;
      padding: 8px 14px;
    }

    .action-btn.btn-delete:hover {
      background: rgba(255, 60, 60, 0.22);
      border-color: rgba(255, 80, 80, 0.6);
      color: #ff4444;
    }

    .video-card.deleting {
      opacity: 0.4;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .empty-state {
      max-width: 500px;
      margin: 80px auto;
      text-align: center;
      padding: 40px;
      border: 1px dashed var(--card-border);
      border-radius: 8px;
    }

    .empty-title {
      font-size: 1.2rem;
      margin-bottom: 12px;
      color: #fff;
    }

    .empty-desc {
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.6;
    }
  </style>
</head>
<body>

  <header class="archive-header">
    <div class="brand-section">
      <img src="/MEOTTAERO.JPG" alt="MOTTAERO" class="brand-logo">
      <div>
        <h1 class="brand-title">SIDANCE ✕ FUTURE YOU</h1>
        <p class="brand-sub">// EXHIBITION VIDEO ARCHIVE</p>
      </div>
    </div>
    <div class="header-actions">
      <a href="/sidance" class="btn">← 무대 화면으로 이동</a>
      <button onclick="window.location.reload()" class="btn btn-accent">🔄 새로고침</button>
    </div>
  </header>

  <div class="stats-bar">
    <span>총 <%= (videos && videos.length) || 0 %>개의 녹화 영상 (최신순)</span>
    <span>스토리지: Supabase Cloud Storage (booth/sidance)</span>
  </div>

  <% if (videos && videos.length > 0) { %>
    <div class="video-grid">
      <% videos.forEach(function(video) { 
          // Format date from filename sidance_YYYYMMDD_HHMMSS_SSS.webm
          var match = video.name.match(/sidance_(\d{4})(\d{2})(\d{2})_(\d{2})(\d{2})(\d{2})/);
          var dateFormatted = match 
            ? match[1] + '.' + match[2] + '.' + match[3] + ' ' + match[4] + ':' + match[5] + ':' + match[6]
            : (video.createdAt ? new Date(video.createdAt).toLocaleString('ko-KR') : '-');
          var sizeMb = (video.size / (1024 * 1024)).toFixed(2) + ' MB';
      %>
        <div class="video-card">
          <div class="video-wrapper">
            <video 
              class="video-player" 
              src="<%= video.url %>" 
              controls 
              preload="metadata" 
              playsinline>
            </video>
          </div>
          <div class="video-info">
            <div class="video-name" title="<%= video.name %>"><%= video.name %></div>
            <div class="video-meta">
              <span>📅 <%= dateFormatted %></span>
              <span class="badge-size"><%= sizeMb %></span>
            </div>
            <div class="video-actions">
              <a href="<%= video.url %>" target="_blank" class="action-btn btn-play">새창 열기 ↗</a>
              <a href="<%= video.url %>" download="<%= video.name %>" class="action-btn">다운로드 ⬇</a>
              <button class="action-btn btn-delete" onclick="deleteVideo(this, '<%= video.name %>')">🗑</button>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <h2 class="empty-title">저장된 녹화 영상이 아직 없습니다</h2>
      <p class="empty-desc">
        무대 화면에서 관객이 3초 이상 인식되면<br>
        자동으로 녹화되어 이곳에 실시간으로 표시됩니다.
      </p>
      <div style="margin-top: 24px;">
        <a href="/sidance" class="btn btn-accent">무대 화면 바로가기</a>
      </div>
    </div>
  <% } %>

<script>
async function deleteVideo(btn, fileName) {
  if (!confirm(`"${fileName}" 영상을 Supabase에서 삭제할까요?\n이 작업은 되돌릴 수 없습니다.`)) return;

  const card = btn.closest('.video-card');
  card.classList.add('deleting');

  try {
    const res = await fetch(`/api/sidance/videos/${encodeURIComponent(fileName)}`, {
      method: 'DELETE'
    });
    const data = await res.json();
    if (data.success) {
      card.style.transition = 'opacity 0.4s, transform 0.4s';
      card.style.opacity = '0';
      card.style.transform = 'scale(0.95)';
      setTimeout(() => card.remove(), 420);

      // Update count
      const statsEl = document.querySelector('.stats-bar span');
      if (statsEl) {
        const match = statsEl.textContent.match(/(\d+)/);
        if (match) statsEl.textContent = statsEl.textContent.replace(match[0], String(parseInt(match[0]) - 1));
      }
    } else {
      alert('삭제 실패: ' + (data.error || '알 수 없는 오류'));
      card.classList.remove('deleting');
    }
  } catch (err) {
    alert('삭제 중 오류 발생: ' + err.message);
    card.classList.remove('deleting');
  }
}
</script>
</body>
</html>
