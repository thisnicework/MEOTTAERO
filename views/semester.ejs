<%- include('partials/header') %>

  <main class="fixed">
    <section id="one" class="left" aria-expanded="false">
      <div class="semesters">
        <% semesters.forEach(function(semester) { %>
          <a class="semester block <%= semester.id === activeSemester.id ? 'active' : '' %> <%= semester.isEmpty ? 'empty' : '' %>"
            href="/projects/<%= semester.id %>">
            <h2 class="bold">
              <%= semester.title %>
            </h2>
            <h3>
              <% if (semester.isUpcoming) { %>
                COMING SOON &thinsp;&mdash;&thinsp; <%= semester.term %>
                  <% } else { %>
                    <%= semester.term %>
                      <% } %>
            </h3>
          </a>
          <% }); %>
      </div>
    </section>
    <section id="two" class="right" aria-expanded="true">
      <div class="semester" style="align-items: flex-start; justify-content: space-between; max-width: 480px;">
        <div class="info">
          <h2 class="bold">
            <%= activeSemester.title %>
          </h2>
          <h3>
            <%= activeSemester.term %>
          </h3>
        </div>
        <% if (activeSemester.id==='dance-marathon' ) { %>
          <img src="/dancemarathon_logo.png?v=2" alt="DANCE MARATHON Logo"
            style="height: 57px; width: auto; min-width: unset; min-height: unset; object-fit: contain; margin-right: 0; margin-left: var(--margin); align-self: flex-start; margin-top: 0;">
          <% } %>
        <% if (activeSemester.id==='the-sia-vol-2' ) { %>
          <img src="/thesia_vol.2.png?v=2" alt="THE SIA Logo"
            style="height: 57px; width: auto; min-width: unset; min-height: unset; object-fit: contain; margin-right: 0; margin-left: var(--margin); align-self: flex-start; margin-top: 0;">
          <% } %>
        <% if (activeSemester.id==='다놀다농' ) { %>
          <img src="/다놀다농_logo.png?v=5" alt="다놀다농 Logo"
            style="height: 58.7px; width: auto; min-width: unset; min-height: unset; object-fit: contain; margin-right: 0; margin-left: var(--margin); align-self: flex-start; margin-top: 0 !important;">
          <% } %>
      </div>
      <hr>





              <% if (activeSemester.id==='춤출자유vol-2' && false) { %>
                <div id="booking-container" class="booking-section">
                  <h2 class="bold" style="color: var(--color-high); margin-bottom: 1.5rem;">
                    TICKET RESERVATION</h2>
                  <form id="booking-form" class="booking-form" novalidate>
                    <div class="form-group">
                      <label for="name" class="bold">이름</label>
                      <input type="text" id="name" name="name" required placeholder="이름을 입력해 주세요">
                    </div>
                    <div class="form-group">
                      <label for="studentId" class="bold">학번 & 학과</label>
                      <input type="text" id="studentId" name="studentId" required placeholder="예: 2632000 / 실음전공">
                    </div>
                    <div class="form-group">
                      <label for="phone" class="bold">연락처</label>
                      <input type="tel" id="phone" name="phone" required placeholder="예: 010-1234-5678">
                    </div>
                    <div class="form-group privacy-group" style="margin-bottom: 1.5rem;">
                      <label class="privacy-label"
                        style="display: flex; align-items: flex-start; cursor: pointer; font-size: 0.95em; line-height: 1.4; color: var(--color-fg);">
                        <input type="checkbox" id="privacy-consent" name="privacyConsent" required
                          style="margin-right: 0.5rem; margin-top: 0.2rem; cursor: pointer;">
                        <span class="bold">개인정보 수집 및 이용 동의 (필수)</span>
                      </label>
                      <div class="privacy-box"
                        style="font-size: 0.85em; line-height: 1.5; color: var(--color-fg); opacity: 0.85; margin-top: 0.5rem; padding: 0.8rem; border: 1px solid var(--color-fg); background: rgba(255, 255, 255, 0.02); backdrop-filter: blur(10px);">
                        <p>동의를 거부하실 수 있으나 파티 참여가 불가능 합니다.</p>
                        <p><strong>수집하는 개인정보 항목:</strong> 초상권 (사진•영상포함)</p>
                        <p><strong>수집 및 이용 목적:</strong> 멋대로 프로젝트 관련 아카이브 제작 및 홍보 자료 활용</p>
                        <p><strong>보유 및 이용기간:</strong> 아카이브 목적 달성 시까지 (필요 시 내부 기록 보관용으로 일부 보존)</p>
                      </div>
                    </div>
                    <div id="form-error" class="form-error-msg" style="display: none;"></div>
                    <button type="submit" class="submit-btn bold" disabled>예매하기 (RESERVE)</button>
                  </form>

                  <!-- Glassmorphic Success State (initially hidden) -->
                  <div id="booking-success" class="booking-success" style="display: none;">
                    <div class="success-card">
                      <div class="success-icon">✓</div>
                      <h2 class="bold">예매 완료 (Reservation Confirmed)</h2>
                      <p class="success-desc">파티 입장을 위한 예매가 정상적으로 처리되었습니다.</p>
                      <hr>
                      <div class="success-details">
                        <p><strong>이름:</strong> <span id="res-name" class="bold"></span></p>
                      </div>
                    </div>
                  </div>
                </div>
                <hr>
                <% } %>

                  <% if (activeSemester.description) { %>
                    <%- activeSemester.description %>
                      <% } %>

                        <% if (activeSemester.id==='다놀다농' ) { %>
                          <hr>
                          <style>
                            .diagonal-poster {
                              position: absolute;
                              width: 68%;
                              height: 75%;
                              object-fit: cover;
                              border: 1px solid var(--color-fg);
                              background: white;
                              box-shadow: 0 4px 15px rgba(0,0,0,0.12);
                              transition: transform 0.3s ease, box-shadow 0.3s ease;
                              cursor: pointer;
                            }
                            .diagonal-poster:hover,
                            .diagonal-poster.active-hover {
                              transform: scale(1.015) translate3d(0, -3px, 0) !important;
                              box-shadow: 0 8px 20px rgba(0,0,0,0.18);
                            }
                          </style>
                          <div class="poster-diagonal-container" style="position: relative; max-width: 480px; width: 100%; aspect-ratio: 1 / 1.15; margin: 3rem 0; user-select: none;">
                            <img class="diagonal-poster" src="/다놀다농_1.jpeg" alt="다놀다농 포스터 1" style="top: 0; left: 0; z-index: 3; transform: rotate(-1deg);" data-base-z="3">
                            <img class="diagonal-poster" src="/다놀다농_2.jpeg" alt="다놀다농 포스터 2" style="top: 10%; left: 15%; z-index: 2; transform: rotate(1.5deg);" data-base-z="2">
                            <img class="diagonal-poster" src="/다놀다농_3.jpeg" alt="다놀다농 포스터 3" style="top: 20%; left: 30%; z-index: 1; transform: rotate(-2deg);" data-base-z="1">
                          </div>
                          <% } %>

                          <% if (activeSemester.id==='dance-marathon' ) { %>
                            <hr>
                            <img src="/dancemarathon_poster.PNG?v=1" alt="DANCE MARATHON Poster"
                              style="max-width: 480px; width: 100%; height: auto; display: block; margin-top: 1.5rem; margin-bottom: 1.5rem;">
                            <% } %>

                            <% if (activeSemester.id==='the-sia-vol-2' ) { %>
                              <hr>
                              <img src="/thesia_vol.2_a3.png" alt="THE SIA Vol.2 Poster"
                                style="max-width: 480px; width: 100%; height: auto; display: block; margin-top: 1.5rem; margin-bottom: 1.5rem;">
                              <% } %>

                                <% if (activeSemester.id==='춤출자유vol-2' ) { %>
                                  <hr>
                                  <div class="video-archive-wrapper" style="position: relative; max-width: 480px; width: 100%; border: none; margin-top: 1rem;">
                                    <video class="archive-video" autoplay loop muted playsinline preload="auto" style="width: 100%; height: auto; display: block; border: none;">
                                      <source
                                        src="https://pysxtikwokpcyfjstdyv.supabase.co/storage/v1/object/public/videos/DancefreedomVol2.mp4"
                                        type="video/mp4">
                                    </video>
                                    <button type="button" class="sound-mute-btn" onclick="toggleMute(this)" title="소리 켜기/끄기" style="position: absolute; bottom: 12px; right: 12px; background: rgba(0, 0, 0, 0.65); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; cursor: pointer; backdrop-filter: blur(4px); z-index: 10; transition: all 0.2s ease;">
                                      <!-- Muted icon (default) -->
                                      <svg class="icon-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 5L6 9H2v6h4l5 4V5zM23 9l-6 6M17 9l6 6"/>
                                      </svg>
                                      <!-- Unmuted icon -->
                                      <svg class="icon-unmuted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
                                        <path d="M11 5L6 9H2v6h4l5 4V5zM19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
                                      </svg>
                                    </button>
                                  </div>
                                  <% } %>

                                    <% if (activeSemester.id==='춤출자유vol-1' ) { %>
                                      <hr>
                                      <div class="video-archive-wrapper" style="position: relative; max-width: 480px; width: 100%; border: none; margin-top: 1rem;">
                                        <video class="archive-video" autoplay loop muted playsinline preload="auto" style="width: 100%; height: auto; display: block; border: none;">
                                          <source
                                            src="https://pysxtikwokpcyfjstdyv.supabase.co/storage/v1/object/public/videos/meottearo.mp4#t=30"
                                            type="video/mp4">
                                        </video>
                                        <button type="button" class="sound-mute-btn" onclick="toggleMute(this)" title="소리 켜기/끄기" style="position: absolute; bottom: 12px; right: 12px; background: rgba(0, 0, 0, 0.65); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; cursor: pointer; backdrop-filter: blur(4px); z-index: 10; transition: all 0.2s ease;">
                                          <!-- Muted icon (default) -->
                                          <svg class="icon-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 5L6 9H2v6h4l5 4V5zM23 9l-6 6M17 9l6 6"/>
                                          </svg>
                                          <!-- Unmuted icon -->
                                          <svg class="icon-unmuted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
                                            <path d="M11 5L6 9H2v6h4l5 4V5zM19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
                                          </svg>
                                        </button>
                                      </div>
                                      <% } %>

                                      <script>
                                        function toggleMute(btn) {
                                          const wrapper = btn.closest('.video-archive-wrapper');
                                          const video = wrapper ? wrapper.querySelector('video') : null;
                                          if (!video) return;

                                          video.muted = !video.muted;
                                          const iconMuted = btn.querySelector('.icon-muted');
                                          const iconUnmuted = btn.querySelector('.icon-unmuted');

                                          if (video.muted) {
                                            if (iconMuted) iconMuted.style.display = 'block';
                                            if (iconUnmuted) iconUnmuted.style.display = 'none';
                                            btn.style.background = 'rgba(0, 0, 0, 0.65)';
                                          } else {
                                            if (iconMuted) iconMuted.style.display = 'none';
                                            if (iconUnmuted) iconUnmuted.style.display = 'block';
                                            btn.style.background = 'var(--color-high, #196f3d)';
                                          }
                                        }
                                      </script>

                                            <% if (activeSemester.id==='다놀다농' ) { %>
                                              <script>
                                                document.addEventListener('DOMContentLoaded', function () {
                                                  // Diagonal poster hover / touch interaction
                                                  const diagonalContainer = document.querySelector('.poster-diagonal-container');
                                                  if (diagonalContainer) {
                                                    const posters = Array.from(diagonalContainer.querySelectorAll('.diagonal-poster'));
                                                    let currentMaxZ = 10;
                                                    
                                                    posters.forEach(poster => {
                                                      const bringToTop = () => {
                                                        currentMaxZ += 1;
                                                        poster.style.zIndex = currentMaxZ;
                                                      };
                                                      
                                                      // Hover events (mouse)
                                                      poster.addEventListener('mouseenter', bringToTop);
                                                      
                                                      // Touch events (mobile)
                                                      poster.addEventListener('touchstart', (e) => {
                                                        posters.forEach(p => p.classList.remove('active-hover'));
                                                        poster.classList.add('active-hover');
                                                        bringToTop();
                                                      });
                                                    });

                                                    // Clicking outside container resets mobile touch active state
                                                    document.addEventListener('touchstart', (e) => {
                                                      if (!diagonalContainer.contains(e.target)) {
                                                        posters.forEach(p => {
                                                          p.classList.remove('active-hover');
                                                        });
                                                      }
                                                    });
                                                  }

                                                  const form = document.getElementById('booking-form');
                                                  const errorDiv = document.getElementById('form-error');
                                                  const successDiv = document.getElementById('booking-success');
                                                  const resCode = document.getElementById('res-code');
                                                  const resName = document.getElementById('res-name');
                                                  const resDetail = document.getElementById('res-detail');

                                                  if (!form) return;

                                                  const privacyConsent = document.getElementById('privacy-consent');
                                                  const submitBtn = form.querySelector('.submit-btn');

                                                  function formatPhoneNumber(val) {
                                                    const nums = val.replace(/[^0-9]/g, '');
                                                    if (nums.length <= 3) return nums;
                                                    if (nums.length <= 7) return `${nums.slice(0, 3)}-${nums.slice(3)}`;
                                                    if (nums.length <= 11) return `${nums.slice(0, 3)}-${nums.slice(3, nums.length - 4)}-${nums.slice(nums.length - 4)}`;
                                                    return `${nums.slice(0, 3)}-${nums.slice(3, 7)}-${nums.slice(7, 11)}`;
                                                  }

                                                  function isValidKoreanPhone(val) {
                                                    const nums = val.replace(/[^0-9]/g, '');
                                                    const mobileRegex = /^01[016789]\d{7,8}$/;
                                                    const landlineRegex = /^0(2|[3-6][1-5])\d{7,8}$/;
                                                    return mobileRegex.test(nums) || landlineRegex.test(nums);
                                                  }

                                                  const phoneInput = document.getElementById('phone');
                                                  if (phoneInput) {
                                                    phoneInput.setAttribute('maxlength', '13');
                                                    phoneInput.addEventListener('input', function () {
                                                      this.value = formatPhoneNumber(this.value);
                                                    });
                                                  }

                                                  if (privacyConsent && submitBtn) {
                                                    submitBtn.disabled = !privacyConsent.checked;

                                                    privacyConsent.addEventListener('change', function () {
                                                      submitBtn.disabled = !this.checked;
                                                    });
                                                  }

                                                  form.addEventListener('submit', function (e) {
                                                    e.preventDefault();
                                                    errorDiv.style.display = 'none';

                                                    const name = document.getElementById('name').value.trim();
                                                    const phone = document.getElementById('phone').value.trim();
                                                    const ageGroup = document.getElementById('ageGroup').value;
                                                    const residence = document.getElementById('residence').value.trim();
                                                    const referral = document.getElementById('referral').value;

                                                    const sessionCheckboxes = form.querySelectorAll('input[name="sessions"]:checked');
                                                    const sessions = Array.from(sessionCheckboxes).map(cb => cb.value);

                                                    if (!name || !phone || !ageGroup || !residence || !referral || sessions.length === 0) {
                                                      errorDiv.textContent = '모든 필드를 올바르게 입력하고 신청 회차를 최소 하나 이상 선택해 주세요.';
                                                      errorDiv.style.display = 'block';
                                                      return;
                                                    }

                                                    const originalText = submitBtn.textContent;
                                                    submitBtn.disabled = true;
                                                    submitBtn.textContent = '처리 중 (PROCESSING...)';

                                                    fetch('/projects/다놀다농/book', {
                                                      method: 'POST',
                                                      headers: {
                                                        'Content-Type': 'application/json',
                                                      },
                                                      body: JSON.stringify({ name, phone, ageGroup, residence, referral, sessions })
                                                    })
                                                      .then(res => res.json())
                                                      .then(data => {
                                                        submitBtn.disabled = false;
                                                        submitBtn.textContent = originalText;

                                                        if (data.error) {
                                                          errorDiv.textContent = data.error;
                                                          errorDiv.style.display = 'block';
                                                        } else if (data.success) {
                                                          resCode.textContent = data.booking.code;
                                                          resName.textContent = data.booking.name;
                                                          resDetail.textContent = data.booking.studentId;

                                                          form.style.display = 'none';
                                                          successDiv.style.display = 'block';
                                                        }
                                                      })
                                                      .catch(err => {
                                                        submitBtn.disabled = false;
                                                        submitBtn.textContent = originalText;
                                                        errorDiv.textContent = '서버 통신 오류가 발생했습니다. 다시 시도해 주세요.';
                                                        errorDiv.style.display = 'block';
                                                      });
                                                  });
                                                });
                                              </script>
                                              <% } %>

                                                <% if (activeSemester.id==='춤출자유vol-2' && false) { %>

                                                  <script>
                                                    document.addEventListener('DOMContentLoaded', function () {
                                                      const form = document.getElementById('booking-form');
                                                      const errorDiv = document.getElementById('form-error');
                                                      const successDiv = document.getElementById('booking-success');
                                                      const resName = document.getElementById('res-name');
                                                      const resetBtn = document.getElementById('reset-booking-btn');

                                                      if (!form) return;

                                                      const privacyConsent = document.getElementById('privacy-consent');
                                                      const submitBtn = form.querySelector('.submit-btn');

                                                      if (privacyConsent && submitBtn) {
                                                        submitBtn.disabled = !privacyConsent.checked;

                                                        privacyConsent.addEventListener('change', function () {
                                                          submitBtn.disabled = !this.checked;
                                                        });

                                                        form.addEventListener('reset', function () {
                                                          submitBtn.disabled = true;
                                                        });
                                                      }

                                                      form.addEventListener('submit', function (e) {
                                                        e.preventDefault();
                                                        errorDiv.style.display = 'none';

                                                        const name = document.getElementById('name').value.trim();
                                                        const studentId = document.getElementById('studentId').value.trim();
                                                        const phone = document.getElementById('phone').value.trim();
                                                        const privacyConsent = document.getElementById('privacy-consent');
                                                        const tickets = 1; // Always 1 ticket

                                                        if (!name || !studentId || !phone) {
                                                          errorDiv.textContent = '모든 필드를 올바르게 입력해 주세요.';
                                                          errorDiv.style.display = 'block';
                                                          return;
                                                        }

                                                        if (privacyConsent && !privacyConsent.checked) {
                                                          errorDiv.textContent = '개인정보 수집 및 이용 동의는 필수입니다.';
                                                          errorDiv.style.display = 'block';
                                                          return;
                                                        }

                                                        const submitBtn = form.querySelector('.submit-btn');
                                                        const originalText = submitBtn.textContent;
                                                        submitBtn.disabled = true;
                                                        submitBtn.textContent = '처리 중 (PROCESSING...)';

                                                        fetch('/projects/춤출자유vol-2/book', {
                                                          method: 'POST',
                                                          headers: {
                                                            'Content-Type': 'application/json',
                                                          },
                                                          body: JSON.stringify({ name, studentId, phone, tickets })
                                                        })
                                                          .then(res => res.json())
                                                          .then(data => {
                                                            submitBtn.disabled = false;
                                                            submitBtn.textContent = originalText;

                                                            if (data.error) {
                                                              errorDiv.textContent = data.error;
                                                              errorDiv.style.display = 'block';
                                                            } else if (data.success) {
                                                              // Populate success state details
                                                              resName.textContent = data.booking.name;

                                                              // Hide form, show success state
                                                              form.style.display = 'none';
                                                              successDiv.style.display = 'block';
                                                            }
                                                          })
                                                          .catch(err => {
                                                            submitBtn.disabled = false;
                                                            submitBtn.textContent = originalText;
                                                            errorDiv.textContent = '서버 통신 오류가 발생했습니다. 다시 시도해 주세요.';
                                                            errorDiv.style.display = 'block';
                                                          });
                                                      });

                                                      if (resetBtn) {
                                                        resetBtn.addEventListener('click', function () {
                                                          form.reset();
                                                          form.style.display = 'block';
                                                          successDiv.style.display = 'none';
                                                        });
                                                      }
                                                    });
                                                  </script>
                                                  <% } %>

                                                    <div class="projects">
                                                      <% if (projects.length===0) { %>
                                                        <% if (!activeSemester.description) { %>
                                                          <p>No projects documented for this semester yet.</p>
                                                          <% } %>
                                                            <% } else { %>
                                                              <% projects.forEach(function(p) { %>
                                                                <% const student=db.getStudent(p.studentId); %>
                                                                  <a class="project block"
                                                                    href="/projects/<%= activeSemester.id %>/<%= p.slug %>">
                                                                    <img class="thumb" src="<%= p.thumbUrl %>"
                                                                      alt="preview image of <%= p.title %>">
                                                                    <div>
                                                                      <h2>
                                                                        <%= student ? student.name : 'Student' %>
                                                                      </h2>
                                                                      <h3 class="bold">
                                                                        <%= p.title %>
                                                                      </h3>
                                                                    </div>
                                                                  </a>
                                                                  <% }); %>
                                                                    <% } %>
                                                    </div>
    </section>
  </main>

  <%- include('partials/footer') %>