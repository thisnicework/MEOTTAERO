<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 100vw;
      height: 100vh;
      background: #000;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    #stream-frame {
      max-width: 100vw;
      max-height: 100vh;
      width: auto;
      height: auto;
      object-fit: contain;
      margin: auto;
      display: none;
    }
  </style>
</head>
<body>
  <!-- Pure Video Frame Display (Dead Center Aligned) -->
  <img id="stream-frame" src="" alt="Live Stream">

  <!-- Standby Screen (Only when offline) -->
  <div id="standby-screen" style="display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; font-family: monospace; text-align: center; padding: 2rem;">
    <div style="font-size: 3rem; opacity: 0.2; margin-bottom: 0.5rem;">📹</div>
    <div style="font-size: 1rem; opacity: 0.4;">[ STANDBY / OFFLINE ]</div>
  </div>

  <script>
    (function () {
      const frameImg = document.getElementById('stream-frame');
      const standbyScreen = document.getElementById('standby-screen');

      async function fetchLiveStream() {
        try {
          const res = await fetch('/api/stream/live');
          const data = await res.json();

          if (data.success && data.active && data.frame) {
            let frameSrc = data.frame;
            if (frameSrc.startsWith('http')) {
              frameSrc = frameSrc.split('?')[0] + '?t=' + Date.now();
            }
            frameImg.src = frameSrc;
            frameImg.style.display = 'block';
            standbyScreen.style.display = 'none';
          } else {
            frameImg.style.display = 'none';
            standbyScreen.style.display = 'flex';
          }
        } catch (err) {
          console.error('Stream fetch error:', err);
        }
      }

      setInterval(fetchLiveStream, 1000);
      fetchLiveStream();
    })();
  </script>
</body>
</html>
